[{"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-810d-ac22-fd99f80e5e47", "content_blocks": [{"content_block": {"content": "# 05_Fondamenti_ICT", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Fondamenti di Information e Communication Technology. Materia propedeutica che introduce i concetti base dell'informatica e delle telecomunicazioni.", "block_property": "paragraph"}}, {"content_block": {"content": "> ⚠️ **Nessun materiale didattico presente** in `01_Materiale/`. Questa nota è un placeholder da integrare con dispense e slide delle lezioni.", "block_property": "paragraph"}}, {"content_block": {"content": "📚 Indice degli argomenti (attesi dal syllabus ITS Cloud Specialist)", "block_property": "heading_2"}}, {"content_block": {"content": "1. Architettura dei Calcolatori", "block_property": "heading_3"}}, {"content_block": {"content": "CPU, memoria, bus, dispositivi I/O", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Ciclo fetch-execute, architettura di von Neumann", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Gerarchia di memoria (cache, RAM, storage)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Sistemi Operativi", "block_property": "heading_3"}}, {"content_block": {"content": "Gestione processi, memoria, file system, I/O", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Kernel vs user space, system call", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Reti di Calcolatori", "block_property": "heading_3"}}, {"content_block": {"content": "Modello OSI e TCP/IP", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Indirizzamento IP, subnetting, routing", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Protocolli applicativi (HTTP, FTP, DNS, SMTP)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Basi di Dati", "block_property": "heading_3"}}, {"content_block": {"content": "Modello relazionale, SQL, normalizzazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Transazioni ACID", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. Ciclo di Sviluppo Software", "block_property": "heading_3"}}, {"content_block": {"content": "Algoritmi e flow chart", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Linguaggi compilati vs interpretati", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Version control, testing, deployment", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "Materia propedeutica — i concetti vengono ripresi in dettaglio nelle materie successive", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "La **gerarchia di memoria** spiega le performance dei sistemi moderni", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Il **modello OSI** è tassonomico, il **TCP/IP** è implementativo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materie collegate**: Tutte le materie tecniche", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-8142-bec1-f6915473b5f8", "content_blocks": [{"content_block": {"content": "# [06] Reti e Sicurezza Informatica", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Materia che copre i fondamenti della cybersecurity e delle reti di calcolatori. Divisa in due macro-aree: **Sicurezza Informatica** (prof. Marco Farina) — crittografia, hashing, password, certificati digitali — e **Reti** (prof. Andrea Blanchietti) — indirizzamento IPv4/IPv6, subnetting, VLAN, routing inter-VLAN.", "block_property": "paragraph"}}, {"content_block": {"content": "**Tecnologie/strumenti**: OpenSSL, Python (cifrario di Cesare, entropia), Cisco Packet Tracer, JohnTheRipper, Wireshark (menzionato)", "block_property": "paragraph"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Introduzione alla Cybersecurity", "block_property": "heading_3"}}, {"content_block": {"content": "**Triade CIA**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "- **Confidentiality** — dati accessibili solo a soggetti autorizzati", "block_property": "paragraph"}}, {"content_block": {"content": "- **Integrity** — dati non alterati durante il ciclo di vita", "block_property": "paragraph"}}, {"content_block": {"content": "- **Availability** — dati e sistemi disponibili quando richiesti", "block_property": "paragraph"}}, {"content_block": {"content": "**Valutazione del rischio**: `r = p × d` (probabilità × danno)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Livelli di sicurezza**: personale, aziendale, nazionale", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Cyberwarfare**: Stuxnet, spionaggio, sabotaggio infrastrutture, propaganda", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Gestione delle Password", "block_property": "heading_3"}}, {"content_block": {"content": "**Entropia delle password**: `H = log₂(|Σ|^L) = L × log₂(|Σ|)`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Spazio delle chiavi** per vari alfabeti:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "| Alfabeto | Cardinalità | Entropia/simbolo |", "block_property": "paragraph"}}, {"content_block": {"content": "|----------|-------------|------------------|", "block_property": "paragraph"}}, {"content_block": {"content": "| PIN (0-9) | 10 | 3.33 bit |", "block_property": "paragraph"}}, {"content_block": {"content": "| Esadecimale | 16 | 4 bit |", "block_property": "paragraph"}}, {"content_block": {"content": "| Minuscole (a-z) | 26 | 4.7 bit |", "block_property": "paragraph"}}, {"content_block": {"content": "| Alfanumerico | 36 | 5.17 bit |", "block_property": "paragraph"}}, {"content_block": {"content": "| Case-sensitive + numeri | 62 | 5.95 bit |", "block_property": "paragraph"}}, {"content_block": {"content": "| ASCII stampabile | 94 | 6.55 bit |", "block_property": "paragraph"}}, {"content_block": {"content": "| Byte (0-255) | 256 | 8 bit |", "block_property": "paragraph"}}, {"content_block": {"content": "**Password da 12 caratteri ASCII** → ~78.7 bit di entropia", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Tecniche di intrusione**: default password, social engineering, attacchi a dizionario (`/usr/share/wordlists`), forza bruta (JohnTheRipper, AirCrack)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Regola pratica**: `passphrase > password complessa` (es. \"correct horse battery staple\" = 127 bit)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Introduzione alla Crittografia", "block_property": "heading_3"}}, {"content_block": {"content": "**Steganografia vs Crittografia**: nascondere l'esistenza del messaggio vs renderlo incomprensibile", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Cifrario di Cesare**: sostituzione con shift `k=2`:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  meet me after the toga party → OGGV OG CHVGT VJG VQIC RCTVA", "block_property": "paragraph"}}, {"content_block": {"content": "**Spazio delle chiavi**: solo 26 possibilità → attacco brute-force banale", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Cifratura monoalfabetica**: permutazione casuale dell'alfabeto (26! ≈ 2^88 chiavi) → vulnerabile ad analisi delle frequenze", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Cifrario di Vigénère**: cifratura polialfabetica con chiave parola", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Crittografia moderna (1900+)**: Bletchley Park, Shannon, DES, AES, crittografia a chiave pubblica", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Crittografia DES e AES", "block_property": "heading_3"}}, {"content_block": {"content": "**DES** (Data Encryption Standard):", "block_property": "paragraph"}}, {"content_block": {"content": "Chiave: 56 bit effettivi (64 bit con 8 di parità)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Struttura: 16 round di Feistel network", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Spazio chiavi: 2^56 ≈ 7.2×10^16", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Deep Crack (1999)**: 1536 CPU, 92 miliardi chiavi/s, 22 ore, $200K → OGGI INSICURO", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**AES** (Advanced Encryption Standard):", "block_property": "paragraph"}}, {"content_block": {"content": "Vincitore del concorso NIST (2000), successore del DES", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Chiavi: 128, 192, 256 bit", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Struttura: SP-network (non Feistel), 10/12/14 round", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**AES-256**: standard attuale per dati classificati (NSA Top Secret)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "# Cifratura AES-256-CBC con OpenSSL", "block_property": "paragraph"}}, {"content_block": {"content": "openssl rand -hex 16 > iv.txt", "block_property": "paragraph"}}, {"content_block": {"content": "openssl rand 32 > key.bin", "block_property": "paragraph"}}, {"content_block": {"content": "KEY_HEX=$(xxd -p key.bin | tr -d '\\n')", "block_property": "paragraph"}}, {"content_block": {"content": "IV_HEX=$(cat iv.txt | tr -d '\\n')", "block_property": "paragraph"}}, {"content_block": {"content": "openssl enc -aes-256-cbc -K \"$KEY_HEX\" -iv \"$IV_HEX\" -in messaggio.txt -out messaggio.enc", "block_property": "paragraph"}}, {"content_block": {"content": "5. Diffie-Hellman-Merkle Key Exchange", "block_property": "heading_3"}}, {"content_block": {"content": "**Problema**: come condividere una chiave segreta su un canale pubblico?", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Metodo dei lucchetti** (analogia): Alice chiude con lucchetto, Bob aggiunge il suo, Alice rimuove il suo, Bob rimuove il suo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Puzzle di Merkle**: Bob genera 2^n puzzle con ID+chiave casuale; Alice ne sceglie uno, lo risolve e invia ID; l'attaccante deve risolvere in media 2^(n-1) puzzle", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Diffie-Hellman** (1976, New Directions in Cryptography):", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "- Basato sulla difficoltà del **logaritmo discreto**", "block_property": "paragraph"}}, {"content_block": {"content": "- `g^a mod p` scambiato pubblicamente → chiave condivisa `g^(ab) mod p`", "block_property": "paragraph"}}, {"content_block": {"content": "- Mitigazione: >2048 bit, forward secrecy", "block_property": "paragraph"}}, {"content_block": {"content": "6. Crittografia a Chiave Pubblica e RSA", "block_property": "heading_3"}}, {"content_block": {"content": "**Cifrari simmetrici**: stessa chiave per cifrare/decifrare (permutazioni e sostituzioni)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Asimmetria**: chiave pubblica (cifra) + chiave privata (decifra) — basata su funzioni matematiche unidirezionali", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**RSA** (Rivest-Shamir-Adleman, 1977):", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "- Basato sulla fattorizzazione del prodotto di due numeri primi grandi", "block_property": "paragraph"}}, {"content_block": {"content": "- `n = p × q`, chiave pubblica `(n, e)`, chiave privata `(n, d)`", "block_property": "paragraph"}}, {"content_block": {"content": "- `c = m^e mod n`, `m = c^d mod n`", "block_property": "paragraph"}}, {"content_block": {"content": "**Flusso**: Bob usa chiave pubblica di Alice per cifrare → solo Alice decifra con sua chiave privata", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "7. Certificati Digitali e Hashing", "block_property": "heading_3"}}, {"content_block": {"content": "**Funzioni di hash**: `H = h(M)` — mappano input arbitrario in output lunghezza fissa", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Proprietà: **non invertibile**, resistenza a collisioni, effetto valanga", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Firma digitale**: hash del messaggio cifrato con chiave privata del mittente → verifica con chiave pubblica", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Certificato digitale**: lega identità + chiave pubblica + firma della CA", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**PKI** (Public Key Infrastructure): gerarchia di Certificate Authority", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Man-in-the-middle**: risolto con certificazione tramite CA", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Esempi di hash: SHA-256, SHA-3, MD5 (rotto, non usare)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "8. Entropia e Compressione", "block_property": "heading_3"}}, {"content_block": {"content": "**Entropia di Shannon**: `H(X) = -∑ P(x) × log₂(P(x))`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Primo teorema di Shannon**: impossibile comprimere sotto l'entropia senza perdita", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "File con solo 'a' → entropia ≈ 0 → compressione 5000:1", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "File casuale → entropia ≈ 6.6 bit/simbolo → compressione trascurabile", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "def calculate_entropy(data):", "block_property": "paragraph"}}, {"content_block": {"content": "    counter = Counter(data)", "block_property": "paragraph"}}, {"content_block": {"content": "    length = len(data)", "block_property": "paragraph"}}, {"content_block": {"content": "    entropy = 0", "block_property": "paragraph"}}, {"content_block": {"content": "    for count in counter.values():", "block_property": "paragraph"}}, {"content_block": {"content": "        p = count / length", "block_property": "paragraph"}}, {"content_block": {"content": "        entropy -= p * math.log2(p)", "block_property": "paragraph"}}, {"content_block": {"content": "    return entropy", "block_property": "paragraph"}}, {"content_block": {"content": "9. Indirizzamento IPv4", "block_property": "heading_3"}}, {"content_block": {"content": "Struttura: 32 bit in 4 ottetti (notazione decimale puntata)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Subnet mask**: separa parte rete da parte host", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Prefix length**: `/24` = 255.255.255.0 = 24 bit di rete", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Indirizzi riservati**: network address (host bit = 0), broadcast (host bit = 1)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Host disponibili**: `2^n - 2` (tolti network e broadcast)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Classi legacy**: A (0-127), B (128-191), C (192-223), D (multicast), E (sperimentale)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Indirizzi privati** (RFC 1918):", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "- Classe A: `10.0.0.0/8`", "block_property": "paragraph"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-813f-9e55-ca846a30a168", "content_blocks": [{"content_block": {"content": "# [07] Version Control Git", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Materia dedicata al controllo di versione distribuito con Git. Copre l'intero flusso di lavoro: repository locale, branching, repository remoti (GitHub/GitLab) e client grafici. Approccio progressivo dai fondamenti agli strumenti GUI.", "block_property": "paragraph"}}, {"content_block": {"content": "**Tecnologie**: Git (CLI), GitHub, GitLab, Git GUI (Sourcetree, GitKraken, VS Code)", "block_property": "paragraph"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Fondamenti di Version Control", "block_property": "heading_3"}}, {"content_block": {"content": "**Cos'è il version control**: tracciamento delle modifiche ai file nel tempo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**VCS Centralizzato** (SVN, CVS): server singolo, single point of failure", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**VCS Distribuito** (Git, Mercurial): ogni clone è un backup completo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Concetti base**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "- Repository (repo): contenitore del progetto", "block_property": "paragraph"}}, {"content_block": {"content": "- Commit: snapshot dello stato dei file", "block_property": "paragraph"}}, {"content_block": {"content": "- Hash SHA-1: identificatore univoco di ogni commit", "block_property": "paragraph"}}, {"content_block": {"content": "**Flusso base**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  git init                    # crea nuovo repository", "block_property": "paragraph"}}, {"content_block": {"content": "  git add <file>              # staging area", "block_property": "paragraph"}}, {"content_block": {"content": "  git commit -m \"messaggio\"   # salva snapshot", "block_property": "paragraph"}}, {"content_block": {"content": "  git log                     # cronologia commit", "block_property": "paragraph"}}, {"content_block": {"content": "  git status                  # stato attuale", "block_property": "paragraph"}}, {"content_block": {"content": "2. Git Locale e Branch", "block_property": "heading_3"}}, {"content_block": {"content": "**Working directory → Staging area → Repository** (tre stati di Git)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Branch**: puntatore mobile a un commit; ramo di sviluppo indipendente", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Comandi branch**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  git branch <nome>           # crea branch", "block_property": "paragraph"}}, {"content_block": {"content": "  git checkout <nome>         # switcha a branch", "block_property": "paragraph"}}, {"content_block": {"content": "  git switch <nome>           # alternativa moderna (Git 2.23+)", "block_property": "paragraph"}}, {"content_block": {"content": "  git merge <branch>          # unisce branch nel corrente", "block_property": "paragraph"}}, {"content_block": {"content": "**Merge**: automatico (fast-forward o 3-way) o manuale (conflitto da risolvere)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Conflitti**: succedono quando stesso file modificato in due branch", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  <<<<<<< HEAD", "block_property": "paragraph"}}, {"content_block": {"content": "  nostro codice", "block_property": "paragraph"}}, {"content_block": {"content": "  =======", "block_property": "paragraph"}}, {"content_block": {"content": "  loro codice", "block_property": "paragraph"}}, {"content_block": {"content": "  >>>>>>> feature-branch", "block_property": "paragraph"}}, {"content_block": {"content": "**Stash**: salva modifiche temporanee senza commit", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  git stash        # salva", "block_property": "paragraph"}}, {"content_block": {"content": "  git stash pop    # ripristina", "block_property": "paragraph"}}, {"content_block": {"content": "3. Git Remoto e Repository Online", "block_property": "heading_3"}}, {"content_block": {"content": "**git clone**: copia un repository remoto in locale", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**git remote**: gestisce connessioni a repository remoti", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**git push**: invia commit locali al remoto", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**git pull**: recupera e unisce (fetch + merge) dal remoto", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**git fetch**: recupera senza unire", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Flusso collaborativo base**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  git clone <url>", "block_property": "paragraph"}}, {"content_block": {"content": "  git checkout -b feature/nuova-funzionalità", "block_property": "paragraph"}}, {"content_block": {"content": "  # ...lavoro...", "block_property": "paragraph"}}, {"content_block": {"content": "  git add . && git commit -m \"feat: aggiunta funzionalità X\"", "block_property": "paragraph"}}, {"content_block": {"content": "  git push origin feature/nuova-funzionalità", "block_property": "paragraph"}}, {"content_block": {"content": "  # → aprire Pull Request su GitHub", "block_property": "paragraph"}}, {"content_block": {"content": "**GitHub/Lab**: fork, pull request, code review, issues, actions/CI", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Git GUI e Client Grafici", "block_property": "heading_3"}}, {"content_block": {"content": "**GitHub Desktop**: semplice, integrazione GitHub nativa", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Sourcetree**: visuale, branching grafico, flow Git-flow", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**GitKraken**: cross-platform, integrazione issue tracker", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**VS Code Git**: built-in, staging visuale, diff editor, branch switcher", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**gitg / GitEye / Git Cola**: alternative Linux/lightweight", "block_property": "bulleted_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**Commit atomici e frequenti**: un commit = un'unità logica di modifica", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Messaggi di commit chiari**: imperativo, prima riga <72 caratteri", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Mai pushare su main/master diretto**: usare feature branch + PR", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Pull sempre prima di push**: `git pull --rebase` per cronologia lineare", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**`.gitignore`**: non committare mai file binari, secret, `node_modules/`, `.env`", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Non fare rebase su branch pubblici**: altera la cronologia", "block_property": "numbered_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/** — Esercizi pratici su Git locale e remoto", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/** — Progetti con workflow Git", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materiale**: 4 PDF (lezioni 1-4) + quiz DOCX", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-818a-8100-cbd092c35919", "content_blocks": [{"content_block": {"content": "# [08] Basi di Dati SQL/NoSQL", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Materia dedicata alla progettazione e gestione di database relazionali (SQL) e non relazionali (NoSQL). Si lavora con SQL Server e SQLite su database reali: biblioteche, gallerie d'arte, scuole italiane, statistica ISTAT, gestione esami.", "block_property": "paragraph"}}, {"content_block": {"content": "**Tecnologie**: SQL (T-SQL, SQLite), SQL Server Management Studio, ADO.NET (C#)", "block_property": "paragraph"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Modellazione dei Dati", "block_property": "heading_3"}}, {"content_block": {"content": "**Modello concettuale**: entità-relazioni (ER), attributi, chiavi", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Modello logico**: tabelle, vincoli, normalizzazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Modello fisico**: indici, storage, performance", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Schema logico** (es. Gestione Esami): entità (Studente, Esame, Corso, Docente) e relazioni", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Linguaggio SQL", "block_property": "heading_3"}}, {"content_block": {"content": "**DDL** (Data Definition Language):", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  CREATE TABLE, ALTER TABLE, DROP TABLE", "block_property": "paragraph"}}, {"content_block": {"content": "  CREATE INDEX, CREATE VIEW", "block_property": "paragraph"}}, {"content_block": {"content": "**DML** (Data Manipulation Language):", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  SELECT, INSERT, UPDATE, DELETE", "block_property": "paragraph"}}, {"content_block": {"content": "**DQL** (Data Query Language):", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  SELECT con JOIN, GROUP BY, HAVING, ORDER BY, WHERE", "block_property": "paragraph"}}, {"content_block": {"content": "**DCL** (Data Control Language): GRANT, REVOKE", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**TCL** (Transaction Control): BEGIN TRAN, COMMIT, ROLLBACK", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Vincoli e Relazioni", "block_property": "heading_3"}}, {"content_block": {"content": "**PRIMARY KEY**: identificatore univoco di riga", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**FOREIGN KEY**: relazione tra tabelle, integrità referenziale", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**UNIQUE**: valori non duplicati", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**CHECK**: validazione valori", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**NOT NULL**: campo obbligatorio", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**CASCADE**: aggiornamento/cancellazione a catena su FK", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Join e Sottoquery", "block_property": "heading_3"}}, {"content_block": {"content": "**INNER JOIN**: solo righe corrispondenti in entrambe le tabelle", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**LEFT/RIGHT JOIN**: tutte le righe di una tabella + corrispondenze", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**FULL OUTER JOIN**: tutte le righe di entrambe", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**CROSS JOIN**: prodotto cartesiano", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Sottoquery**: `SELECT ... WHERE campo IN (SELECT ...)`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. NoSQL", "block_property": "heading_3"}}, {"content_block": {"content": "**Concetti**: schema-less, orizzontalmente scalabile, BASE (non ACID)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Tipologie**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "- **Document store** (MongoDB): dati in JSON/BSON", "block_property": "paragraph"}}, {"content_block": {"content": "- **Key-value** (Redis): accesso rapido per chiave", "block_property": "paragraph"}}, {"content_block": {"content": "- **Column-family** (Cassandra): wide-column store", "block_property": "paragraph"}}, {"content_block": {"content": "- **Graph** (Neo4j): nodi e relazioni", "block_property": "paragraph"}}, {"content_block": {"content": "**Quando usare SQL vs NoSQL**: schemas rigidi vs flessibili, relazioni complesse vs volumi enormi", "block_property": "bulleted_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**Sempre PRIMARY KEY su ogni tabella**: Mai una tabella senza chiave primaria", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Vincoli FK per integrità**: Non affidarsi solo all'applicazione", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Normalizzazione (3NF)**: evita ridondanza; denormalizzare solo per performance misurate", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**SELECT \\* è dannoso**: Specificare sempre le colonne necessarie", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Indicizzare le colonne in WHERE/JOIN**: impatto enorme sulle performance", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Sempre backup prima di ALTER/DROP**: I .bak sono tuoi amici", "block_property": "numbered_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/** — Query SQL, esercizi di progettazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/** — Progetti con database reali", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materiale**: NorthWind.sql, ScuoleItaliane.sql, GalleriaArte-PalazzoMadama.bak, Istat.bak, GestioneEsami.xlsx", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-81ba-b02c-f41856655be0", "content_blocks": [{"content_block": {"content": "# 10_Programmazione_Python", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Programmazione Python per applicazioni cloud e automazione. Il linguaggio è usato trasversalmente nel corso per scripting, analisi dati (pandas, matplotlib), automazione cloud, e project work.", "block_property": "paragraph"}}, {"content_block": {"content": "> ⚠️ **Nessuna cartella `01_Materiale/` presente** — il materiale didattico non è incluso nel repository. La struttura comprende solo `02_Esercizi/` e `03_Progetti/`.", "block_property": "paragraph"}}, {"content_block": {"content": "📚 Indice degli argomenti (attesi dal syllabus)", "block_property": "heading_2"}}, {"content_block": {"content": "1. Fondamenti di Python", "block_property": "heading_3"}}, {"content_block": {"content": "Tipi di dato, variabili, operatori", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Strutture di controllo (if, for, while)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Funzioni, parametri, return, scope", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Type hints (`list[int]`, `-> None`)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Strutture Dati", "block_property": "heading_3"}}, {"content_block": {"content": "Liste, tuple, dict, set", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "List comprehension, slicing", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Iterazione e enumerazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. File e I/O", "block_property": "heading_3"}}, {"content_block": {"content": "Lettura/scrittura file con `open()` e context manager", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "`pathlib.Path` per gestione percorsi", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Moduli e Package", "block_property": "heading_3"}}, {"content_block": {"content": "Organizzazione progetto, `__init__.py`, `if __name__ == \"__main__\":`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "`pip` e requirements.txt", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. Librerie per Cloud/DevOps", "block_property": "heading_3"}}, {"content_block": {"content": "`boto3` (AWS SDK), `azure-*` (Azure SDK), `google-cloud-*` (GCP SDK)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "`docker-py` per container", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "`kubernetes` client per K8s", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "`paramiko` per SSH automation", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "`requests` per API REST", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "Python è usato **trasversalmente** — scripting, automazione cloud, data analysis", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Type hints** migliorano manutenibilità e permettono type checking statico", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Preferire **pathlib.Path** a `os.path` per manipolazione path", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Usare **context manager** (`with`) per file e connessioni", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "I file di esercizi e progetti sono in `02_Esercizi/` e `03_Progetti/`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/**: Esercizi Python", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/**: Progetti Python", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materie collegate**: `20_Data_Analytics_Visualization`, `14_Cloud_Azure`, `17_Container_Docker_Kubernetes`", "block_property": "bulleted_list_item"}}]}}]