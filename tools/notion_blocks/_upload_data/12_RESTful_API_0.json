{"page_id": "391f85d3-4899-819e-a65d-f0c83d7a133f", "blocks": [{"content_block": {"content": "# [12] RESTful API", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Materia dedicata alla progettazione e implementazione di API RESTful. Si costruisce progressivamente una libreria online partendo da semplici array in memoria fino a database SQLite con autenticazione JWT e Swagger.", "block_property": "paragraph"}}, {"content_block": {"content": "**Tecnologie**: Node.js (Express), SQLite, Swagger/OpenAPI, JWT, HTTPS, body-parser, ESM (ECMAScript Modules)", "block_property": "paragraph"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Fondamenti REST", "block_property": "heading_3"}}, {"content_block": {"content": "**REST** (Representational State Transfer): architettura stateless basata su risorse", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Verbi HTTP**: GET (leggi), POST (crea), PUT (aggiorna completo), PATCH (aggiorna parziale), DELETE (elimina)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Stateless**: ogni richiesta contiene tutte le info necessarie", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**URI risorse**: `/api/v1/libri`, `/api/v1/libri/123`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Codici di stato**: 200 OK, 201 Created, 204 No Content, 400 Bad Request, 401 Unauthorized, 404 Not Found, 500 Server Error", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. JSON e Formato Dati", "block_property": "heading_3"}}, {"content_block": {"content": "{", "block_property": "paragraph"}}, {"content_block": {"content": "  \"id\": 1,", "block_property": "paragraph"}}, {"content_block": {"content": "  \"titolo\": \"Il Nome della Rosa\",", "block_property": "paragraph"}}, {"content_block": {"content": "  \"autore\": \"Umberto Eco\",", "block_property": "paragraph"}}, {"content_block": {"content": "  \"anno\": 1980", "block_property": "paragraph"}}, {"content_block": {"content": "}", "block_property": "paragraph"}}, {"content_block": {"content": "**Content-Type**: `application/json`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Request/Response** strutturati e consistenti", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Progettazione API", "block_property": "heading_3"}}, {"content_block": {"content": "**URL naming**: sostantivi plurali (`/libri`, non `/libro`)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Filtri**: `GET /api/libri?autore=Eco&anno=1980`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Paginazione**: `GET /api/libri?page=1&limit=10`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Versioning**: `/api/v1/...`, `/api/v2/...`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Implementazione con Express (Node.js)", "block_property": "heading_3"}}, {"content_block": {"content": "import express from 'express';", "block_property": "paragraph"}}, {"content_block": {"content": "import bodyParser from 'body-parser';", "block_property": "paragraph"}}, {"content_block": {"content": "const app = express();", "block_property": "paragraph"}}, {"content_block": {"content": "app.use(bodyParser.json());", "block_property": "paragraph"}}, {"content_block": {"content": "const PORT = 3000;", "block_property": "paragraph"}}, {"content_block": {"content": "// GET tutti i libri", "block_property": "paragraph"}}, {"content_block": {"content": "app.get('/api/v1/libri', (req, res) => {", "block_property": "paragraph"}}, {"content_block": {"content": "  res.json(libri);", "block_property": "paragraph"}}, {"content_block": {"content": "});", "block_property": "paragraph"}}, {"content_block": {"content": "// POST nuovo libro", "block_property": "paragraph"}}, {"content_block": {"content": "app.post('/api/v1/libri', (req, res) => {", "block_property": "paragraph"}}, {"content_block": {"content": "  const nuovoLibro = { id: nextId++, ...req.body };", "block_property": "paragraph"}}, {"content_block": {"content": "  libri.push(nuovoLibro);", "block_property": "paragraph"}}, {"content_block": {"content": "  res.status(201).json(nuovoLibro);", "block_property": "paragraph"}}, {"content_block": {"content": "});", "block_property": "paragraph"}}, {"content_block": {"content": "app.listen(PORT, () => console.log(`Server su porta ${PORT}`));", "block_property": "paragraph"}}, {"content_block": {"content": "**Evoluzione**: v1 (array in memoria) → v2 (SQLite persistente)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Middleware**: body-parser, logger, CORS, auth", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. SQLite come Storage", "block_property": "heading_3"}}, {"content_block": {"content": "import sqlite3 from 'sqlite3';", "block_property": "paragraph"}}, {"content_block": {"content": "const db = new sqlite3.Database('libreria.db');", "block_property": "paragraph"}}, {"content_block": {"content": "db.run(`CREATE TABLE IF NOT EXISTS libri (", "block_property": "paragraph"}}, {"content_block": {"content": "  id INTEGER PRIMARY KEY AUTOINCREMENT,", "block_property": "paragraph"}}, {"content_block": {"content": "  titolo TEXT NOT NULL,", "block_property": "paragraph"}}, {"content_block": {"content": "  autore TEXT NOT NULL,", "block_property": "paragraph"}}, {"content_block": {"content": "  anno INTEGER", "block_property": "paragraph"}}, {"content_block": {"content": ")`);", "block_property": "paragraph"}}, {"content_block": {"content": "6. HTTPS / JWT / Autenticazione", "block_property": "heading_3"}}, {"content_block": {"content": "**HTTPS**: TLS/SSL per crittografia del canale", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**JWT** (JSON Web Token): autenticazione stateless", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  Header.Payload.Signature", "block_property": "paragraph"}}, {"content_block": {"content": "**Flusso**: login → JWT → token in `Authorization: Bearer <token>`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Middleware di autenticazione**: `jwt.verify(token, secret)`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**JWT vs HttpOnly Cookie**: JWT per SPA/mobile, cookie per SSR", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "7. Swagger / OpenAPI", "block_property": "heading_3"}}, {"content_block": {"content": "Documentazione automatica delle API", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Formato: `swagger.json` (OpenAPI 2.0) o `openapi.yaml` (3.0)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "UI interattiva: `swagger-ui-express`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Try it out**: test diretto dalla documentazione", "block_property": "bulleted_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**REST non è CRUD**: i verbi HTTP esprimono azioni, non solo operazioni database", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Versiona le API**: non rompere i client esistenti", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Valida sempre input**: mai fidarsi di req.body", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Usa HTTPS in produzione**: sempre, sempre, sempre", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Password mai in chiaro**: hashing con bcrypt, non scrivere in DB", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Middleware**: incapsula auth, log, errori in middleware riutilizzabili", "block_property": "numbered_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/** — Esercizi su routing, middleware, database", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/** — LibreriaOnline (v1, v2.1, v2.2, v2-final), MUSICLAB", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materiale**: PDF lezioni 1-5, guida HTML, Swagger, JWT, test DOCX", "block_property": "bulleted_list_item"}}], "chunk_idx": 0, "total_chunks": 1}