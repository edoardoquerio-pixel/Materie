[{"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-81ff-b442-fb32cd529dc2", "content_blocks": [{"content_block": {"content": "# 21_Internet_of_Things", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Internet of Things — connessione di dispositivi fisici alla rete per raccolta dati, monitoraggio e automazione. Include architetture IoT, protocolli di comunicazione, cloud IoT, edge computing e sicurezza.", "block_property": "paragraph"}}, {"content_block": {"content": "> ⚠️ **Nessun materiale didattico presente** in `01_Materiale/`. Questa nota è un placeholder da integrare.", "block_property": "paragraph"}}, {"content_block": {"content": "📚 Indice degli argomenti (attesi dal syllabus)", "block_property": "heading_2"}}, {"content_block": {"content": "1. Architetture IoT", "block_property": "heading_3"}}, {"content_block": {"content": "Modello a 3/4/5 livelli (Device, Edge, Cloud)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "IoT Reference Architecture (ISO/IEC 30141)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Gateway IoT e protocolli fieldbus", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Protocolli di Comunicazione", "block_property": "heading_3"}}, {"content_block": {"content": "**MQTT**: Pub/sub, QoS, topic, broker (Mosquitto)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**CoAP**: UDP-based, REST-like per constrained devices", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**HTTP/HTTPS**: REST API per device", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**LoRaWAN / NB-IoT**: LPWAN per lunga distanza e basso consumo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Piattaforme Cloud IoT", "block_property": "heading_3"}}, {"content_block": {"content": "**AWS IoT Core**: Device shadow, rules engine, greengrass", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Azure IoT Hub**: Device twin, direct methods, IoT Edge", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**GCP IoT Core** (deprecato): Alternative (Pub/Sub + Cloud IoT)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Hardware e Sensori", "block_property": "heading_3"}}, {"content_block": {"content": "**Microcontrollori**: Arduino, ESP32, STM32", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Single Board Computer**: Raspberry Pi", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Sensori**: Temperatura, umidità, pressione, movimento, gas, GPS", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. Edge Computing", "block_property": "heading_3"}}, {"content_block": {"content": "Elaborazione locale vs cloud, latenza, bandwidth", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "AWS Greengrass, Azure IoT Edge", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "ML on edge (TensorFlow Lite)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "6. Sicurezza IoT", "block_property": "heading_3"}}, {"content_block": {"content": "Crittografia end-to-end, secure boot, TPM", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Firmware update (OTA)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Vulnerabilità comuni: default password, clear-text protocols", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**MQTT** è il protocollo IoT standard (leggero, pub/sub, QoS 0-2)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "L'**edge computing** riduce latenza e banda verso il cloud", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "La **sicurezza** è la sfida più grande (milioni di device, spesso con risorse limitate)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Digital Twin**: replica virtuale del dispositivo fisico nel cloud", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materie collegate**: `06_Reti_e_Sicurezza_Informatica`, `14_Cloud_Azure`, `13_Cloud_AWS`", "block_property": "bulleted_list_item"}}]}}]