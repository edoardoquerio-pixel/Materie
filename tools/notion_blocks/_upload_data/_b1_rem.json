[{"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-8142-bec1-f6915473b5f8", "content_blocks": [{"content_block": {"content": "- Classe B: `172.16.0.0/12` (172.16.0.0 – 172.31.255.255)", "block_property": "paragraph"}}, {"content_block": {"content": "- Classe C: `192.168.0.0/16`", "block_property": "paragraph"}}, {"content_block": {"content": "**Calcolo subnet** (esempio):", "block_property": "paragraph"}}, {"content_block": {"content": "192.168.10.5/24 → rete: 192.168.10.0/24, broadcast: 192.168.10.255, host: 192.168.10.1-254", "block_property": "paragraph"}}, {"content_block": {"content": "172.21.152.12/16 → rete: 172.21.0.0/16, broadcast: 172.21.255.255, host: 172.21.0.1-172.21.255.254", "block_property": "paragraph"}}, {"content_block": {"content": "10. VLAN (Virtual LAN)", "block_property": "heading_3"}}, {"content_block": {"content": "**Segmentazione logica** dello switch in domini di broadcast separati", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Vantaggi**: domini broadcast più piccoli, maggiore sicurezza, efficienza IT, riduzione costi, prestazioni", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Tipi di VLAN**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "- **VLAN dati**: traffico utente (email, web)", "block_property": "paragraph"}}, {"content_block": {"content": "- **VLAN nativa**: frame senza tag su trunk 802.1Q", "block_property": "paragraph"}}, {"content_block": {"content": "- **VLAN di gestione**: SSH/Telnet, SVI dello switch Layer 2", "block_property": "paragraph"}}, {"content_block": {"content": "- **VLAN voce**: QoS, banda garantita, latenza <150ms", "block_property": "paragraph"}}, {"content_block": {"content": "- **VLAN predefinita (VLAN 1)**: non eliminabile, sconsigliata per gestione", "block_property": "paragraph"}}, {"content_block": {"content": "**Tag 802.1Q**: 4 byte con TPID (0x8100), priorità, CFI, VID (12 bit → 4096 VLAN)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**VLAN multi-switch**: collegamento trunk porta-point tra switch", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "11. InterVLAN Routing", "block_property": "heading_3"}}, {"content_block": {"content": "Le VLAN sono isolate al Layer 2 → serve un **dispositivo Layer 3** per comunicare tra VLAN", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Metodo legacy**: router con interfaccia fisica per ogni VLAN (costoso, non scalabile)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Router-on-a-stick**: una sola interfaccia fisica con sottointerfacce 802.1Q:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  interface GigabitEthernet0/0.10", "block_property": "paragraph"}}, {"content_block": {"content": "   encapsulation dot1Q 10", "block_property": "paragraph"}}, {"content_block": {"content": "   ip address 192.168.10.1 255.255.255.0", "block_property": "paragraph"}}, {"content_block": {"content": "  !", "block_property": "paragraph"}}, {"content_block": {"content": "  interface GigabitEthernet0/0.20", "block_property": "paragraph"}}, {"content_block": {"content": "   encapsulation dot1Q 20", "block_property": "paragraph"}}, {"content_block": {"content": "   ip address 192.168.20.1 255.255.255.0", "block_property": "paragraph"}}, {"content_block": {"content": "**Switch Layer 3 (SVIs)**: interfacce virtuali, routing interno allo switch", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "12. Sistemi Numerici", "block_property": "heading_3"}}, {"content_block": {"content": "**Binario (base 2)**: simboli 0,1 — potenze di 2", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Esadecimale (base 16)**: simboli 0-9,A-F — potenze di 16", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Conversione decimale → binario**: divisioni successive per 2", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Conversione binario → esadecimale**: raggruppa 4 bit per cifra", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  89 decimale = 1011001 binario = 0x59", "block_property": "paragraph"}}, {"content_block": {"content": "  7B41 esadecimale = 31553 decimale", "block_property": "paragraph"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**CIA Triad** è il fondamento: nessuna sicurezza senza tutti e tre gli aspetti", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Entropia** misura la forza di una password — mai sotto 60 bit per account importanti", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Crittografia simmetrica** (AES) per volumi grandi di dati; **asimmetrica** (RSA, DH) per scambio chiavi e firme", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Non si scrivono algoritmi crittografici propri** — usare librerie standard (OpenSSL, Cryptography.io)", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Hash + chiave privata = firma digitale**; l'hash non è crittografia (non è invertibile)", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Niente crittografia homemade** — usa AES-256-GCM, SHA-256, x.509 con CA riconosciute", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Subnetting**: ricordare la formula `2^n - 2` per host utilizzabili", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**VLAN**: isolano il traffico al Layer 2; per routing serve Layer 3 (router-on-a-stick o SVI)", "block_property": "numbered_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/** — Script Python (`Trova_numeri_primi.py` — numeri primi per RSA), esercizi subnetting", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materiale extra**: demo entropia (MD+PY), AES con OpenSSL, cifrario di Cesare, Enigma Keys", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Lab Cisco Packet Tracer**: VLAN, InterVLAN routing (.pkt)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Link**: playlist cybersecurity, condivisione schermo Meet", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Letture**: Estratto \"L'arte dell'inganno\" (Kevin Mitnick), paper originale RSA (Diffie-Hellman 1976)", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-813f-9e55-ca846a30a168", "content_blocks": [{"content_block": {"content": "# [07] Version Control Git", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Materia dedicata al controllo di versione distribuito con Git. Copre l'intero flusso di lavoro: repository locale, branching, repository remoti (GitHub/GitLab) e client grafici. Approccio progressivo dai fondamenti agli strumenti GUI.", "block_property": "paragraph"}}, {"content_block": {"content": "**Tecnologie**: Git (CLI), GitHub, GitLab, Git GUI (Sourcetree, GitKraken, VS Code)", "block_property": "paragraph"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Fondamenti di Version Control", "block_property": "heading_3"}}, {"content_block": {"content": "**Cos'è il version control**: tracciamento delle modifiche ai file nel tempo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**VCS Centralizzato** (SVN, CVS): server singolo, single point of failure", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**VCS Distribuito** (Git, Mercurial): ogni clone è un backup completo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Concetti base**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "- Repository (repo): contenitore del progetto", "block_property": "paragraph"}}, {"content_block": {"content": "- Commit: snapshot dello stato dei file", "block_property": "paragraph"}}, {"content_block": {"content": "- Hash SHA-1: identificatore univoco di ogni commit", "block_property": "paragraph"}}, {"content_block": {"content": "**Flusso base**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  git init                    # crea nuovo repository", "block_property": "paragraph"}}, {"content_block": {"content": "  git add <file>              # staging area", "block_property": "paragraph"}}, {"content_block": {"content": "  git commit -m \"messaggio\"   # salva snapshot", "block_property": "paragraph"}}, {"content_block": {"content": "  git log                     # cronologia commit", "block_property": "paragraph"}}, {"content_block": {"content": "  git status                  # stato attuale", "block_property": "paragraph"}}, {"content_block": {"content": "2. Git Locale e Branch", "block_property": "heading_3"}}, {"content_block": {"content": "**Working directory → Staging area → Repository** (tre stati di Git)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Branch**: puntatore mobile a un commit; ramo di sviluppo indipendente", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Comandi branch**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  git branch <nome>           # crea branch", "block_property": "paragraph"}}, {"content_block": {"content": "  git checkout <nome>         # switcha a branch", "block_property": "paragraph"}}, {"content_block": {"content": "  git switch <nome>           # alternativa moderna (Git 2.23+)", "block_property": "paragraph"}}, {"content_block": {"content": "  git merge <branch>          # unisce branch nel corrente", "block_property": "paragraph"}}, {"content_block": {"content": "**Merge**: automatico (fast-forward o 3-way) o manuale (conflitto da risolvere)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Conflitti**: succedono quando stesso file modificato in due branch", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  <<<<<<< HEAD", "block_property": "paragraph"}}, {"content_block": {"content": "  nostro codice", "block_property": "paragraph"}}, {"content_block": {"content": "  =======", "block_property": "paragraph"}}, {"content_block": {"content": "  loro codice", "block_property": "paragraph"}}, {"content_block": {"content": "  >>>>>>> feature-branch", "block_property": "paragraph"}}, {"content_block": {"content": "**Stash**: salva modifiche temporanee senza commit", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  git stash        # salva", "block_property": "paragraph"}}, {"content_block": {"content": "  git stash pop    # ripristina", "block_property": "paragraph"}}, {"content_block": {"content": "3. Git Remoto e Repository Online", "block_property": "heading_3"}}, {"content_block": {"content": "**git clone**: copia un repository remoto in locale", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**git remote**: gestisce connessioni a repository remoti", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**git push**: invia commit locali al remoto", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**git pull**: recupera e unisce (fetch + merge) dal remoto", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**git fetch**: recupera senza unire", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Flusso collaborativo base**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  git clone <url>", "block_property": "paragraph"}}, {"content_block": {"content": "  git checkout -b feature/nuova-funzionalità", "block_property": "paragraph"}}, {"content_block": {"content": "  # ...lavoro...", "block_property": "paragraph"}}, {"content_block": {"content": "  git add . && git commit -m \"feat: aggiunta funzionalità X\"", "block_property": "paragraph"}}, {"content_block": {"content": "  git push origin feature/nuova-funzionalità", "block_property": "paragraph"}}, {"content_block": {"content": "  # → aprire Pull Request su GitHub", "block_property": "paragraph"}}, {"content_block": {"content": "**GitHub/Lab**: fork, pull request, code review, issues, actions/CI", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Git GUI e Client Grafici", "block_property": "heading_3"}}, {"content_block": {"content": "**GitHub Desktop**: semplice, integrazione GitHub nativa", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Sourcetree**: visuale, branching grafico, flow Git-flow", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**GitKraken**: cross-platform, integrazione issue tracker", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**VS Code Git**: built-in, staging visuale, diff editor, branch switcher", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**gitg / GitEye / Git Cola**: alternative Linux/lightweight", "block_property": "bulleted_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**Commit atomici e frequenti**: un commit = un'unità logica di modifica", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Messaggi di commit chiari**: imperativo, prima riga <72 caratteri", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Mai pushare su main/master diretto**: usare feature branch + PR", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Pull sempre prima di push**: `git pull --rebase` per cronologia lineare", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**`.gitignore`**: non committare mai file binari, secret, `node_modules/`, `.env`", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Non fare rebase su branch pubblici**: altera la cronologia", "block_property": "numbered_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/** — Esercizi pratici su Git locale e remoto", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/** — Progetti con workflow Git", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materiale**: 4 PDF (lezioni 1-4) + quiz DOCX", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-818a-8100-cbd092c35919", "content_blocks": [{"content_block": {"content": "# [08] Basi di Dati SQL/NoSQL", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Materia dedicata alla progettazione e gestione di database relazionali (SQL) e non relazionali (NoSQL). Si lavora con SQL Server e SQLite su database reali: biblioteche, gallerie d'arte, scuole italiane, statistica ISTAT, gestione esami.", "block_property": "paragraph"}}, {"content_block": {"content": "**Tecnologie**: SQL (T-SQL, SQLite), SQL Server Management Studio, ADO.NET (C#)", "block_property": "paragraph"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Modellazione dei Dati", "block_property": "heading_3"}}, {"content_block": {"content": "**Modello concettuale**: entità-relazioni (ER), attributi, chiavi", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Modello logico**: tabelle, vincoli, normalizzazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Modello fisico**: indici, storage, performance", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Schema logico** (es. Gestione Esami): entità (Studente, Esame, Corso, Docente) e relazioni", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Linguaggio SQL", "block_property": "heading_3"}}, {"content_block": {"content": "**DDL** (Data Definition Language):", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  CREATE TABLE, ALTER TABLE, DROP TABLE", "block_property": "paragraph"}}, {"content_block": {"content": "  CREATE INDEX, CREATE VIEW", "block_property": "paragraph"}}, {"content_block": {"content": "**DML** (Data Manipulation Language):", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  SELECT, INSERT, UPDATE, DELETE", "block_property": "paragraph"}}, {"content_block": {"content": "**DQL** (Data Query Language):", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  SELECT con JOIN, GROUP BY, HAVING, ORDER BY, WHERE", "block_property": "paragraph"}}, {"content_block": {"content": "**DCL** (Data Control Language): GRANT, REVOKE", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**TCL** (Transaction Control): BEGIN TRAN, COMMIT, ROLLBACK", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Vincoli e Relazioni", "block_property": "heading_3"}}, {"content_block": {"content": "**PRIMARY KEY**: identificatore univoco di riga", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**FOREIGN KEY**: relazione tra tabelle, integrità referenziale", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**UNIQUE**: valori non duplicati", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**CHECK**: validazione valori", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**NOT NULL**: campo obbligatorio", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**CASCADE**: aggiornamento/cancellazione a catena su FK", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Join e Sottoquery", "block_property": "heading_3"}}, {"content_block": {"content": "**INNER JOIN**: solo righe corrispondenti in entrambe le tabelle", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**LEFT/RIGHT JOIN**: tutte le righe di una tabella + corrispondenze", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**FULL OUTER JOIN**: tutte le righe di entrambe", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**CROSS JOIN**: prodotto cartesiano", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Sottoquery**: `SELECT ... WHERE campo IN (SELECT ...)`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. NoSQL", "block_property": "heading_3"}}, {"content_block": {"content": "**Concetti**: schema-less, orizzontalmente scalabile, BASE (non ACID)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Tipologie**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "- **Document store** (MongoDB): dati in JSON/BSON", "block_property": "paragraph"}}, {"content_block": {"content": "- **Key-value** (Redis): accesso rapido per chiave", "block_property": "paragraph"}}, {"content_block": {"content": "- **Column-family** (Cassandra): wide-column store", "block_property": "paragraph"}}, {"content_block": {"content": "- **Graph** (Neo4j): nodi e relazioni", "block_property": "paragraph"}}, {"content_block": {"content": "**Quando usare SQL vs NoSQL**: schemas rigidi vs flessibili, relazioni complesse vs volumi enormi", "block_property": "bulleted_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**Sempre PRIMARY KEY su ogni tabella**: Mai una tabella senza chiave primaria", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Vincoli FK per integrità**: Non affidarsi solo all'applicazione", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Normalizzazione (3NF)**: evita ridondanza; denormalizzare solo per performance misurate", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**SELECT \\* è dannoso**: Specificare sempre le colonne necessarie", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Indicizzare le colonne in WHERE/JOIN**: impatto enorme sulle performance", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Sempre backup prima di ALTER/DROP**: I .bak sono tuoi amici", "block_property": "numbered_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/** — Query SQL, esercizi di progettazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/** — Progetti con database reali", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materiale**: NorthWind.sql, ScuoleItaliane.sql, GalleriaArte-PalazzoMadama.bak, Istat.bak, GestioneEsami.xlsx", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-81a9-9928-f4c0191de6d1", "content_blocks": [{"content_block": {"content": "# [09] Programmazione C/CPP", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Materia di programmazione strutturata in C. Copre dai fondamenti (variabili, cicli, funzioni) fino a temi avanzati (puntatori, allocazione dinamica, struct, file I/O, ordinamento). Le lezioni sono progressive con guida didattica + esercizi per ogni argomento.", "block_property": "paragraph"}}, {"content_block": {"content": "**Tecnologie**: C (C11/C17), GCC/Clang, CMake, compilatore da riga di comando", "block_property": "paragraph"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Fondamenti (Lezioni 1-9)", "block_property": "heading_3"}}, {"content_block": {"content": "**Lezione 1**: Algoritmi e programmazione — flowchart, pseudocodice", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Lezione 2**: Flowchart — diagrammi di flusso, strutture di controllo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Lezione 3**: Sistema binario — rappresentazione dei numeri, complemento a 2", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Lezione 4**: Decimali e char — tipi di dato, codifica ASCII", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Lezione 6**: Primo programma C:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  #include <stdio.h>", "block_property": "paragraph"}}, {"content_block": {"content": "  int main() {", "block_property": "paragraph"}}, {"content_block": {"content": "      printf(\"Hello, World!\\n\");", "block_property": "paragraph"}}, {"content_block": {"content": "      return 0;", "block_property": "paragraph"}}, {"content_block": {"content": "  }", "block_property": "paragraph"}}, {"content_block": {"content": "**Lezione 7**: Variabili e input — `scanf`, `printf`, tipi (int, float, char)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Lezione 8**: Operatori — aritmetici, logici, relazionali, bitwise", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Lezione 9**: if/else — selezione, operatori ternari", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Controllo di Flusso (Lezioni 10-12)", "block_property": "heading_3"}}, {"content_block": {"content": "**Lezione 10**: switch — selezione multipla", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Lezione 11**: Ciclo while/do-while — iterazione condizionata", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Lezione 12**: Ciclo for — iterazione contata", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Array e Matrici (Lezioni 13-14)", "block_property": "heading_3"}}, {"content_block": {"content": "**Array monodimensionali**: `int v[10];`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Array multidimensionali (matrici)**: `int m[3][4];`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Iterazione su array, inizializzazione, ricerca lineare", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Funzioni e Passaggio Parametri (Lezione 15)", "block_property": "heading_3"}}, {"content_block": {"content": "int somma(int a, int b) {", "block_property": "paragraph"}}, {"content_block": {"content": "    return a + b;", "block_property": "paragraph"}}, {"content_block": {"content": "}", "block_property": "paragraph"}}, {"content_block": {"content": "**Passaggio per valore** (copia) vs **per riferimento** (puntatore)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Prototipi**: dichiarazione prima di `main()`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. Puntatori e Array Dinamici (Lezioni 16-18)", "block_property": "heading_3"}}, {"content_block": {"content": "**Puntatori**: variabili che contengono indirizzi di memoria:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  int x = 10;", "block_property": "paragraph"}}, {"content_block": {"content": "  int *p = &x;", "block_property": "paragraph"}}, {"content_block": {"content": "  *p = 20;  // x ora vale 20", "block_property": "paragraph"}}, {"content_block": {"content": "**Aritmetica dei puntatori**: `p + 1` avanza di sizeof(tipo)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Allocazione dinamica**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  int *arr = malloc(n * sizeof(int));", "block_property": "paragraph"}}, {"content_block": {"content": "  if (arr == NULL) { /* errore */ }", "block_property": "paragraph"}}, {"content_block": {"content": "  arr = realloc(arr, new_size * sizeof(int));", "block_property": "paragraph"}}, {"content_block": {"content": "  free(arr);", "block_property": "paragraph"}}, {"content_block": {"content": "**Puntatori a funzione, puntatori a struct**", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "6. Stringhe (Lezione 21)", "block_property": "heading_3"}}, {"content_block": {"content": "`char s[] = \"Ciao\";` — array di char terminato da `\\0`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Funzioni: `strlen()`, `strcpy()`, `strcat()`, `strcmp()`, `strtok()`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Stringhe dinamiche**: allocazione con `malloc` + `realloc`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "7. Struct e Oggetti in C (Lezioni 22-23)", "block_property": "heading_3"}}, {"content_block": {"content": "typedef struct {", "block_property": "paragraph"}}, {"content_block": {"content": "    char nome[50];", "block_property": "paragraph"}}, {"content_block": {"content": "    int eta;", "block_property": "paragraph"}}, {"content_block": {"content": "} Persona;", "block_property": "paragraph"}}, {"content_block": {"content": "**Array di struct**, puntatori a struct (`->`)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Struct annidate**, campi bit", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "8. File I/O (Lezione 24)", "block_property": "heading_3"}}, {"content_block": {"content": "FILE *f = fopen(\"file.txt\", \"r\");", "block_property": "paragraph"}}, {"content_block": {"content": "if (f) {", "block_property": "paragraph"}}, {"content_block": {"content": "    char buffer[256];", "block_property": "paragraph"}}, {"content_block": {"content": "    while (fgets(buffer, sizeof(buffer), f)) {", "block_property": "paragraph"}}, {"content_block": {"content": "        printf(\"%s\", buffer);", "block_property": "paragraph"}}, {"content_block": {"content": "    }", "block_property": "paragraph"}}, {"content_block": {"content": "    fclose(f);", "block_property": "paragraph"}}, {"content_block": {"content": "}", "block_property": "paragraph"}}, {"content_block": {"content": "Modalità: r, w, a, r+, wb, rb (binario)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "`fprintf`, `fscanf`, `fread`, `fwrite`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "9. Algoritmi di Ordinamento (Lezione 20)", "block_property": "heading_3"}}, {"content_block": {"content": "**Bubble Sort** — O(n²), semplice ma lento", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Selection Sort** — O(n²), minimo scambio", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Insertion Sort** — O(n²), buono per dati quasi ordinati", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Merge Sort / Quick Sort** — O(n log n), divide-et-impera", "block_property": "bulleted_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**Sempre controllare il valore di ritorno di `malloc`**: può fallire → NULL", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**`free()` ogni `malloc()`**: ogni allocazione deve essere deallocata", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Mai usare `gets()`**: buffer overflow sicuro; usare `fgets()`", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Puntatori**: l'operatore `*` dichiara/ dereferenzia, `&` prende l'indirizzo", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Array e puntatori sono correlati**: `arr[i] ≡ *(arr + i)`", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Stringhe**: sempre terminate da `\\0` — lasciare spazio!", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**CMakeLists.txt** per progetti multi-file", "block_property": "numbered_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/** — Esercizi graduati per ogni lezione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/** — Progetti completi (ParcheggioIntelligente, GestioneProntoSoccorso, sviluppoTemaEsame)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materiale extra**: guide didattiche in markdown per puntatori, array dinamici, code/pile", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-81ba-b02c-f41856655be0", "content_blocks": [{"content_block": {"content": "# 10_Programmazione_Python", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Programmazione Python per applicazioni cloud e automazione. Il linguaggio è usato trasversalmente nel corso per scripting, analisi dati (pandas, matplotlib), automazione cloud, e project work.", "block_property": "paragraph"}}, {"content_block": {"content": "> ⚠️ **Nessuna cartella `01_Materiale/` presente** — il materiale didattico non è incluso nel repository. La struttura comprende solo `02_Esercizi/` e `03_Progetti/`.", "block_property": "paragraph"}}, {"content_block": {"content": "📚 Indice degli argomenti (attesi dal syllabus)", "block_property": "heading_2"}}, {"content_block": {"content": "1. Fondamenti di Python", "block_property": "heading_3"}}, {"content_block": {"content": "Tipi di dato, variabili, operatori", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Strutture di controllo (if, for, while)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Funzioni, parametri, return, scope", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Type hints (`list[int]`, `-> None`)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Strutture Dati", "block_property": "heading_3"}}, {"content_block": {"content": "Liste, tuple, dict, set", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "List comprehension, slicing", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Iterazione e enumerazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. File e I/O", "block_property": "heading_3"}}, {"content_block": {"content": "Lettura/scrittura file con `open()` e context manager", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "`pathlib.Path` per gestione percorsi", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Moduli e Package", "block_property": "heading_3"}}, {"content_block": {"content": "Organizzazione progetto, `__init__.py`, `if __name__ == \"__main__\":`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "`pip` e requirements.txt", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. Librerie per Cloud/DevOps", "block_property": "heading_3"}}, {"content_block": {"content": "`boto3` (AWS SDK), `azure-*` (Azure SDK), `google-cloud-*` (GCP SDK)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "`docker-py` per container", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "`kubernetes` client per K8s", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "`paramiko` per SSH automation", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "`requests` per API REST", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "Python è usato **trasversalmente** — scripting, automazione cloud, data analysis", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Type hints** migliorano manutenibilità e permettono type checking statico", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Preferire **pathlib.Path** a `os.path` per manipolazione path", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Usare **context manager** (`with`) per file e connessioni", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "I file di esercizi e progetti sono in `02_Esercizi/` e `03_Progetti/`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/**: Esercizi Python", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/**: Progetti Python", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materie collegate**: `20_Data_Analytics_Visualization`, `14_Cloud_Azure`, `17_Container_Docker_Kubernetes`", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-8174-9934-e50d0c939ed5", "content_blocks": [{"content_block": {"content": "# [11] Programmazione DotNet C#", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Materia di programmazione C# su piattaforma .NET. Si parte dalla console application con esercizi progressivi su iterazione, selezione, array e strutture dati. Utilizza .NET 10 SDK con top-level statements e formato soluzione `.slnx`.", "block_property": "paragraph"}}, {"content_block": {"content": "**Tecnologie**: C# (.NET 10), Visual Studio / VS Code, ADO.NET (database)", "block_property": "paragraph"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Introduzione a C# e .NET", "block_property": "heading_3"}}, {"content_block": {"content": "**Framework**: .NET 10, runtime cross-platform", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Struttura progetto**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  <!-- .csproj -->", "block_property": "paragraph"}}, {"content_block": {"content": "  <Project Sdk=\"Microsoft.NET.Sdk\">", "block_property": "paragraph"}}, {"content_block": {"content": "    <PropertyGroup>", "block_property": "paragraph"}}, {"content_block": {"content": "      <OutputType>Exe</OutputType>", "block_property": "paragraph"}}, {"content_block": {"content": "      <TargetFramework>net10.0</TargetFramework>", "block_property": "paragraph"}}, {"content_block": {"content": "      <ImplicitUsings>enable</ImplicitUsings>", "block_property": "paragraph"}}, {"content_block": {"content": "      <Nullable>enable</Nullable>", "block_property": "paragraph"}}, {"content_block": {"content": "    </PropertyGroup>", "block_property": "paragraph"}}, {"content_block": {"content": "  </Project>", "block_property": "paragraph"}}, {"content_block": {"content": "**Pattern entry point**: top-level statements", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  Console.Write(\"Inserisci nome: \");", "block_property": "paragraph"}}, {"content_block": {"content": "  string nome = Console.ReadLine();", "block_property": "paragraph"}}, {"content_block": {"content": "  Console.WriteLine($\"Ciao, {nome}!\");", "block_property": "paragraph"}}, {"content_block": {"content": "2. Iterazione (Cicli)", "block_property": "heading_3"}}, {"content_block": {"content": "**for**: contatore definito", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  for (int i = 0; i < 10; i++) { ... }", "block_property": "paragraph"}}, {"content_block": {"content": "**while / do-while**: iterazione condizionata", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**foreach**: iterazione su collezioni", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  foreach (int n in numeri) { ... }", "block_property": "paragraph"}}, {"content_block": {"content": "**Esercizi**: stampa 100 interi positivi, stampa 100 pari positivi, frequenza lancio dado, numero primo, estrazione lotto, quadrato somma N numeri dispari", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Selezione Multipla", "block_property": "heading_3"}}, {"content_block": {"content": "**if / else if / else**", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**switch** (con pattern matching C# 7+):", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  int giorno = 3;", "block_property": "paragraph"}}, {"content_block": {"content": "  string nomeGiorno = giorno switch", "block_property": "paragraph"}}, {"content_block": {"content": "  {", "block_property": "paragraph"}}, {"content_block": {"content": "      1 => \"Lunedì\",", "block_property": "paragraph"}}, {"content_block": {"content": "      2 => \"Martedì\",", "block_property": "paragraph"}}, {"content_block": {"content": "      _ => \"Altro giorno\"", "block_property": "paragraph"}}, {"content_block": {"content": "  };", "block_property": "paragraph"}}, {"content_block": {"content": "**Esercizi**: giorno della settimana, calcolo età, pari/dispari, positivo/negativo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. OOP in C#", "block_property": "heading_3"}}, {"content_block": {"content": "**Classi e oggetti**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  public class Persona {", "block_property": "paragraph"}}, {"content_block": {"content": "      public string Nome { get; set; }", "block_property": "paragraph"}}, {"content_block": {"content": "      public int Eta { get; set; }", "block_property": "paragraph"}}, {"content_block": {"content": "      public override string ToString() => $\"{Nome}, {Eta} anni\";", "block_property": "paragraph"}}, {"content_block": {"content": "  }", "block_property": "paragraph"}}, {"content_block": {"content": "**Object initializer**: `new Persona { Nome = \"Mario\", Eta = 25 };`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Enum**: `enum GiornoSettimana { Lun, Mar, Mer, Gio, Ven, Sab, Dom }`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**String interpolation**: `$\"Valore: {x}\"`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. ADO.NET e Database", "block_property": "heading_3"}}, {"content_block": {"content": "Connessione a SQL Server / SQLite", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "`SqlConnection`, `SqlCommand`, `SqlDataReader`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Esecuzione query parametrizzate (protezione SQL injection)", "block_property": "bulleted_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**`ImplicitUsings` abilita**: System, System.Collections.Generic, System.Linq, System.Threading.Tasks ecc.", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Nullable enable**: il compilatore avverte su possibili null reference", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Console.ReadLine()** restituisce `string?` — gestire il null", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**`$\"\"` per string interpolation** — più leggibile di concatenazione", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Top-level statements**: C# 10+ permette codice senza classe Program", "block_property": "numbered_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/** — 10+ esercizi su iterazione, selezione, array", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/** — Progetti completi WinForms e console", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**04_Visual C#/** — Materiale Visual C# aggiuntivo", "block_property": "bulleted_list_item"}}]}}]