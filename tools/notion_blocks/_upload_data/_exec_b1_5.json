[{"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-8174-9934-e50d0c939ed5", "content_blocks": [{"content_block": {"content": "# [11] Programmazione DotNet C#", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Materia di programmazione C# su piattaforma .NET. Si parte dalla console application con esercizi progressivi su iterazione, selezione, array e strutture dati. Utilizza .NET 10 SDK con top-level statements e formato soluzione `.slnx`.", "block_property": "paragraph"}}, {"content_block": {"content": "**Tecnologie**: C# (.NET 10), Visual Studio / VS Code, ADO.NET (database)", "block_property": "paragraph"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Introduzione a C# e .NET", "block_property": "heading_3"}}, {"content_block": {"content": "**Framework**: .NET 10, runtime cross-platform", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Struttura progetto**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  <!-- .csproj -->", "block_property": "paragraph"}}, {"content_block": {"content": "  <Project Sdk=\"Microsoft.NET.Sdk\">", "block_property": "paragraph"}}, {"content_block": {"content": "    <PropertyGroup>", "block_property": "paragraph"}}, {"content_block": {"content": "      <OutputType>Exe</OutputType>", "block_property": "paragraph"}}, {"content_block": {"content": "      <TargetFramework>net10.0</TargetFramework>", "block_property": "paragraph"}}, {"content_block": {"content": "      <ImplicitUsings>enable</ImplicitUsings>", "block_property": "paragraph"}}, {"content_block": {"content": "      <Nullable>enable</Nullable>", "block_property": "paragraph"}}, {"content_block": {"content": "    </PropertyGroup>", "block_property": "paragraph"}}, {"content_block": {"content": "  </Project>", "block_property": "paragraph"}}, {"content_block": {"content": "**Pattern entry point**: top-level statements", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  Console.Write(\"Inserisci nome: \");", "block_property": "paragraph"}}, {"content_block": {"content": "  string nome = Console.ReadLine();", "block_property": "paragraph"}}, {"content_block": {"content": "  Console.WriteLine($\"Ciao, {nome}!\");", "block_property": "paragraph"}}, {"content_block": {"content": "2. Iterazione (Cicli)", "block_property": "heading_3"}}, {"content_block": {"content": "**for**: contatore definito", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  for (int i = 0; i < 10; i++) { ... }", "block_property": "paragraph"}}, {"content_block": {"content": "**while / do-while**: iterazione condizionata", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**foreach**: iterazione su collezioni", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  foreach (int n in numeri) { ... }", "block_property": "paragraph"}}, {"content_block": {"content": "**Esercizi**: stampa 100 interi positivi, stampa 100 pari positivi, frequenza lancio dado, numero primo, estrazione lotto, quadrato somma N numeri dispari", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Selezione Multipla", "block_property": "heading_3"}}, {"content_block": {"content": "**if / else if / else**", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**switch** (con pattern matching C# 7+):", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  int giorno = 3;", "block_property": "paragraph"}}, {"content_block": {"content": "  string nomeGiorno = giorno switch", "block_property": "paragraph"}}, {"content_block": {"content": "  {", "block_property": "paragraph"}}, {"content_block": {"content": "      1 => \"Lunedì\",", "block_property": "paragraph"}}, {"content_block": {"content": "      2 => \"Martedì\",", "block_property": "paragraph"}}, {"content_block": {"content": "      _ => \"Altro giorno\"", "block_property": "paragraph"}}, {"content_block": {"content": "  };", "block_property": "paragraph"}}, {"content_block": {"content": "**Esercizi**: giorno della settimana, calcolo età, pari/dispari, positivo/negativo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. OOP in C#", "block_property": "heading_3"}}, {"content_block": {"content": "**Classi e oggetti**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  public class Persona {", "block_property": "paragraph"}}, {"content_block": {"content": "      public string Nome { get; set; }", "block_property": "paragraph"}}, {"content_block": {"content": "      public int Eta { get; set; }", "block_property": "paragraph"}}, {"content_block": {"content": "      public override string ToString() => $\"{Nome}, {Eta} anni\";", "block_property": "paragraph"}}, {"content_block": {"content": "  }", "block_property": "paragraph"}}, {"content_block": {"content": "**Object initializer**: `new Persona { Nome = \"Mario\", Eta = 25 };`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Enum**: `enum GiornoSettimana { Lun, Mar, Mer, Gio, Ven, Sab, Dom }`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**String interpolation**: `$\"Valore: {x}\"`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. ADO.NET e Database", "block_property": "heading_3"}}, {"content_block": {"content": "Connessione a SQL Server / SQLite", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "`SqlConnection`, `SqlCommand`, `SqlDataReader`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Esecuzione query parametrizzate (protezione SQL injection)", "block_property": "bulleted_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**`ImplicitUsings` abilita**: System, System.Collections.Generic, System.Linq, System.Threading.Tasks ecc.", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Nullable enable**: il compilatore avverte su possibili null reference", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Console.ReadLine()** restituisce `string?` — gestire il null", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**`$\"\"` per string interpolation** — più leggibile di concatenazione", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Top-level statements**: C# 10+ permette codice senza classe Program", "block_property": "numbered_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/** — 10+ esercizi su iterazione, selezione, array", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/** — Progetti completi WinForms e console", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**04_Visual C#/** — Materiale Visual C# aggiuntivo", "block_property": "bulleted_list_item"}}]}}]