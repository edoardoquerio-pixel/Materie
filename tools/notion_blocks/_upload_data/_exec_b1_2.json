[{"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-818a-8100-cbd092c35919", "content_blocks": [{"content_block": {"content": "# [08] Basi di Dati SQL/NoSQL", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Materia dedicata alla progettazione e gestione di database relazionali (SQL) e non relazionali (NoSQL). Si lavora con SQL Server e SQLite su database reali: biblioteche, gallerie d'arte, scuole italiane, statistica ISTAT, gestione esami.", "block_property": "paragraph"}}, {"content_block": {"content": "**Tecnologie**: SQL (T-SQL, SQLite), SQL Server Management Studio, ADO.NET (C#)", "block_property": "paragraph"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Modellazione dei Dati", "block_property": "heading_3"}}, {"content_block": {"content": "**Modello concettuale**: entità-relazioni (ER), attributi, chiavi", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Modello logico**: tabelle, vincoli, normalizzazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Modello fisico**: indici, storage, performance", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Schema logico** (es. Gestione Esami): entità (Studente, Esame, Corso, Docente) e relazioni", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Linguaggio SQL", "block_property": "heading_3"}}, {"content_block": {"content": "**DDL** (Data Definition Language):", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  CREATE TABLE, ALTER TABLE, DROP TABLE", "block_property": "paragraph"}}, {"content_block": {"content": "  CREATE INDEX, CREATE VIEW", "block_property": "paragraph"}}, {"content_block": {"content": "**DML** (Data Manipulation Language):", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  SELECT, INSERT, UPDATE, DELETE", "block_property": "paragraph"}}, {"content_block": {"content": "**DQL** (Data Query Language):", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  SELECT con JOIN, GROUP BY, HAVING, ORDER BY, WHERE", "block_property": "paragraph"}}, {"content_block": {"content": "**DCL** (Data Control Language): GRANT, REVOKE", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**TCL** (Transaction Control): BEGIN TRAN, COMMIT, ROLLBACK", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Vincoli e Relazioni", "block_property": "heading_3"}}, {"content_block": {"content": "**PRIMARY KEY**: identificatore univoco di riga", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**FOREIGN KEY**: relazione tra tabelle, integrità referenziale", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**UNIQUE**: valori non duplicati", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**CHECK**: validazione valori", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**NOT NULL**: campo obbligatorio", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**CASCADE**: aggiornamento/cancellazione a catena su FK", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Join e Sottoquery", "block_property": "heading_3"}}, {"content_block": {"content": "**INNER JOIN**: solo righe corrispondenti in entrambe le tabelle", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**LEFT/RIGHT JOIN**: tutte le righe di una tabella + corrispondenze", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**FULL OUTER JOIN**: tutte le righe di entrambe", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**CROSS JOIN**: prodotto cartesiano", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Sottoquery**: `SELECT ... WHERE campo IN (SELECT ...)`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. NoSQL", "block_property": "heading_3"}}, {"content_block": {"content": "**Concetti**: schema-less, orizzontalmente scalabile, BASE (non ACID)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Tipologie**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "- **Document store** (MongoDB): dati in JSON/BSON", "block_property": "paragraph"}}, {"content_block": {"content": "- **Key-value** (Redis): accesso rapido per chiave", "block_property": "paragraph"}}, {"content_block": {"content": "- **Column-family** (Cassandra): wide-column store", "block_property": "paragraph"}}, {"content_block": {"content": "- **Graph** (Neo4j): nodi e relazioni", "block_property": "paragraph"}}, {"content_block": {"content": "**Quando usare SQL vs NoSQL**: schemas rigidi vs flessibili, relazioni complesse vs volumi enormi", "block_property": "bulleted_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**Sempre PRIMARY KEY su ogni tabella**: Mai una tabella senza chiave primaria", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Vincoli FK per integrità**: Non affidarsi solo all'applicazione", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Normalizzazione (3NF)**: evita ridondanza; denormalizzare solo per performance misurate", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**SELECT \\* è dannoso**: Specificare sempre le colonne necessarie", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Indicizzare le colonne in WHERE/JOIN**: impatto enorme sulle performance", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Sempre backup prima di ALTER/DROP**: I .bak sono tuoi amici", "block_property": "numbered_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/** — Query SQL, esercizi di progettazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/** — Progetti con database reali", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materiale**: NorthWind.sql, ScuoleItaliane.sql, GalleriaArte-PalazzoMadama.bak, Istat.bak, GestioneEsami.xlsx", "block_property": "bulleted_list_item"}}]}}]