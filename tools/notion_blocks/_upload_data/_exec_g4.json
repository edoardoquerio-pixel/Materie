[{"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-81ff-b442-fb32cd529dc2", "content_blocks": [{"content_block": {"content": "# 21_Internet_of_Things", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Internet of Things — connessione di dispositivi fisici alla rete per raccolta dati, monitoraggio e automazione. Include architetture IoT, protocolli di comunicazione, cloud IoT, edge computing e sicurezza.", "block_property": "paragraph"}}, {"content_block": {"content": "> ⚠️ **Nessun materiale didattico presente** in `01_Materiale/`. Questa nota è un placeholder da integrare.", "block_property": "paragraph"}}, {"content_block": {"content": "📚 Indice degli argomenti (attesi dal syllabus)", "block_property": "heading_2"}}, {"content_block": {"content": "1. Architetture IoT", "block_property": "heading_3"}}, {"content_block": {"content": "Modello a 3/4/5 livelli (Device, Edge, Cloud)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "IoT Reference Architecture (ISO/IEC 30141)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Gateway IoT e protocolli fieldbus", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Protocolli di Comunicazione", "block_property": "heading_3"}}, {"content_block": {"content": "**MQTT**: Pub/sub, QoS, topic, broker (Mosquitto)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**CoAP**: UDP-based, REST-like per constrained devices", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**HTTP/HTTPS**: REST API per device", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**LoRaWAN / NB-IoT**: LPWAN per lunga distanza e basso consumo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Piattaforme Cloud IoT", "block_property": "heading_3"}}, {"content_block": {"content": "**AWS IoT Core**: Device shadow, rules engine, greengrass", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Azure IoT Hub**: Device twin, direct methods, IoT Edge", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**GCP IoT Core** (deprecato): Alternative (Pub/Sub + Cloud IoT)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Hardware e Sensori", "block_property": "heading_3"}}, {"content_block": {"content": "**Microcontrollori**: Arduino, ESP32, STM32", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Single Board Computer**: Raspberry Pi", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Sensori**: Temperatura, umidità, pressione, movimento, gas, GPS", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. Edge Computing", "block_property": "heading_3"}}, {"content_block": {"content": "Elaborazione locale vs cloud, latenza, bandwidth", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "AWS Greengrass, Azure IoT Edge", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "ML on edge (TensorFlow Lite)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "6. Sicurezza IoT", "block_property": "heading_3"}}, {"content_block": {"content": "Crittografia end-to-end, secure boot, TPM", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Firmware update (OTA)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Vulnerabilità comuni: default password, clear-text protocols", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**MQTT** è il protocollo IoT standard (leggero, pub/sub, QoS 0-2)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "L'**edge computing** riduce latenza e banda verso il cloud", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "La **sicurezza** è la sfida più grande (milioni di device, spesso con risorse limitate)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Digital Twin**: replica virtuale del dispositivo fisico nel cloud", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materie collegate**: `06_Reti_e_Sicurezza_Informatica`, `14_Cloud_Azure`, `13_Cloud_AWS`", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-81ba-ae3e-ee2f27fc6d8d", "content_blocks": [{"content_block": {"content": "# 22_AI_e_Prompt_Engineering", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Intelligenza Artificiale e Prompt Engineering. Copre i fondamenti dell'AI, machine learning, deep learning, modelli linguistici (LLM), tecniche di prompt engineering e applicazioni pratiche nell'ecosistema cloud e DevOps.", "block_property": "paragraph"}}, {"content_block": {"content": "> ⚠️ **Nessun materiale didattico presente** in `01_Materiale/`. Questa nota è un placeholder da integrare.", "block_property": "paragraph"}}, {"content_block": {"content": "📚 Indice degli argomenti (attesi dal syllabus)", "block_property": "heading_2"}}, {"content_block": {"content": "1. Fondamenti di AI/ML", "block_property": "heading_3"}}, {"content_block": {"content": "AI, Machine Learning, Deep Learning — differenze e relazioni", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Apprendimento supervisionato, non supervisionato, per rinforzo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Bias, varianza, overfitting, underfitting", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Modelli Linguistici (LLM)", "block_property": "heading_3"}}, {"content_block": {"content": "Architettura Transformer (Self-attention, Multi-head attention)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "GPT, Claude, Gemini, Llama — confronto e contesto", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Training: pre-training, fine-tuning, RLHF", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "API e integrazione (OpenAI API, Claude API, Google AI)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Prompt Engineering", "block_property": "heading_3"}}, {"content_block": {"content": "**Zero-shot**, **Few-shot**, **Chain-of-Thought (CoT)**", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**System prompt**, **User prompt**, **Assistant role**", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Struttura prompt: contesto, task, formato, esempi", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Tecniche avanzate**: Tree-of-Thought, ReAct, Self-Consistency", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Temperature, top-p, max_tokens — parametri di generazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. AI nel Cloud", "block_property": "heading_3"}}, {"content_block": {"content": "**AI-as-a-Service**: OpenAI, Anthropic, Google Vertex AI, AWS Bedrock, Azure OpenAI", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**RAG (Retrieval-Augmented Generation)**: Embedding, vector database (Pinecone, Weaviate, Chroma)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**AI Agents**: Tool use, function calling, multi-agent systems", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. Etica e Best Practices", "block_property": "heading_3"}}, {"content_block": {"content": "Bias nei modelli, allucinazioni, safety guardrails", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Privacy dei dati (non inviare dati sensibili a API esterne)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "AI Act EU — regolamentazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**Prompt engineering** è la competenza chiave: un buon prompt definisce ruolo, contesto, task e formato", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Chain-of-Thought** migliora significativamente il ragionamento in task complessi", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**RAG** combina LLM con knowledge base esterna per risposte aggiornate e contestuali", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Parametri critici: **Temperature** (0=deterministico, 0.7=creativo), **Top-p** (nucleus sampling)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Le **allucinazioni** sono il problema principale — validare sempre output critici", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Nessun LLM** va usato per decisioni su dati sensibili senza supervisione umana", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materie collegate**: `10_Programmazione_Python`, `20_Data_Analytics_Visualization`, `12_RESTful_API`", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-81a6-9f77-ed8be286d562", "content_blocks": [{"content_block": {"content": "# 23_Project_Work_e_Laboratori", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Project work enterprise simulato **(TP_Group)** — convergenza e potenziamento servizi IT dopo la fusione tra Thema Consulting e Pro Studio. Assegnato a 9 gruppi di lavoro con budget 520k€ + IVA. Docente: Luca Robaldo. Copre assessment, progettazione, offerta tecnico/economica su infrastruttura IT integrata.", "block_property": "paragraph"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Scenario di Riferimento", "block_property": "heading_3"}}, {"content_block": {"content": "**Thema Consulting** (Torino, 30 persone): Data center on-prem con 2 host VMware, SAN NetApp 24TB, cluster HPC 8 nodi (crash test automotive), servizio Pondus (ottimizzazione pesi), Fortigate FG-60F", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Pro Studio srl** (Torino, 20 persone): Senza infrastruttura IT propria, servizi cloud, calcolo strutturale su sistemi clienti, sede in affitto", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Unione → TP Group**: Integrazione e convergenza dei sistemi informativi", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Assessment — Stato dell'Arte", "block_property": "heading_3"}}, {"content_block": {"content": "**Datacenter Thema**: 2 rack saturi, hypervisor VMware, NAS QNAP 32TB per backup", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Virtualizzazione**: 2 host VMware on-prem (Thema) / nessuno (Pro Studio)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Backup**: On-prem su NAS QNAP (Thema) / on GCP (Pro Studio)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Firewall**: Fortigate FG-60F (Thema) / cloud (Pro Studio)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**HPC**: 8 nodi fisici Linux con Infiniband + 1 frontend VM (Thema)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**UPS e Condizionamento**: Presenti in Thema, assenti in Pro Studio", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Vincoli e Requisiti", "block_property": "heading_3"}}, {"content_block": {"content": "**Vincoli tecnologici**: Sistemi esistenti da integrare, HPC da preservare", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Vincoli logistici**: Due sedi, personale distribuito", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Obiettivi**: Convergenza infrastrutture, disaster recovery, scalabilità, sicurezza", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Budget**: 520.000€ + IVA", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Offerta Tecnico/Economica", "block_property": "heading_3"}}, {"content_block": {"content": "**Requisiti**: Documento di offerta tecnico/economica", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Criteri di valutazione**: Qualità tecnica, costi, timeline, innovazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Costi indicativi risorse**: Stima costi HW, SW, servizi cloud, consulenza", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. Organizzazione del Lavoro", "block_property": "heading_3"}}, {"content_block": {"content": "**9 gruppi di lavoro**: Ogni gruppo si occupa di un'area specifica (rete, security, HPC, app, cloud, backup, ecc.)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Agents**: 9 agenti specializzati in `TP_Group/agents/` (Assessment, Network, Security, HPC, App, Cloud, Backup, Bid, PM)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**KANBAN.md**: Task organizzati per delivery order", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Deliverable tracking**: Dipendenze e milestone tra gruppi", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "6. Aree di Intervento", "block_property": "heading_3"}}, {"content_block": {"content": "**Assessment**: Mappatura attuale infrastrutture Thema + Pro Studio", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Network**: Interconnessione sedi, VPN, VLAN, routing", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Security**: Firewall perimetrale, segmentazione, IAM, compliance", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**HPC**: Cluster computing on-prem/cloud, job scheduling", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**App**: Migrazione/refactoring applicazioni, Pondus", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Cloud**: IaaS/PaaS su cloud provider, hybrid cloud", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Backup/DR**: BC/DR strategy, backup centralizzato, off-site", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Bid**: Offerta economica, giustificativi di prezzo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**PM**: Project management, risk management, reporting", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "Budget **520k€ + IVA** — va motivata ogni voce di spesa", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Assessment iniziale** è fondamentale per capire punto di partenza", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "La fusione richiede **convergenza** non solo tecnica ma anche organizzativa", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "L'**HPC** (8 nodi Infiniband) è asset critico per Thema — va preservato e possibilmente esteso", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Pro Studio** è cloud-native — la convergenza richiederà decisioni su hybrid cloud", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Gruppi di lavoro **inter-dipendenti** — il PM deve coordinare le consegne", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "I **9 agenti specializzati** coprono tutti gli aspetti tecnici ed economici", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**TP_Group/**: KANBAN.md, agents/, deliverable tracking", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**02_Esercizi/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materie collegate**: Tutte le materie tecniche (project work trasversale)", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-81fe-89ad-fefa499aafba", "content_blocks": [{"content_block": {"content": "# 24_Stage_Professionale", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Stage professionale curriculare presso aziende del settore ICT. Periodo di formazione sul campo per applicare le competenze acquisite durante il corso ITS Cloud Specialist in un contesto lavorativo reale.", "block_property": "paragraph"}}, {"content_block": {"content": "> ⚠️ **Nessun materiale didattico presente** in `01_Materiale/`. Questa nota è un placeholder da integrare.", "block_property": "paragraph"}}, {"content_block": {"content": "📚 Indice degli argomenti (attesi dal regolamento ITS)", "block_property": "heading_2"}}, {"content_block": {"content": "1. Organizzazione dello Stage", "block_property": "heading_3"}}, {"content_block": {"content": "**Durata**: Tipicamente 3-6 mesi (800-1200 ore)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Sede**: Aziende partner ITS ICT o ospitanti individuate dallo studente", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Tutor aziendale** e **tutor didattico**: Ruoli e responsabilità", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Documentazione", "block_property": "heading_3"}}, {"content_block": {"content": "**Convenzione**: Accordo ITS-azienda", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Progetto formativo**: Obiettivi, attività, competenze target", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Timesheet**: Registrazione presenze e attività", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Relazione finale**: Documentazione attività svolte", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Diritti e Doveri", "block_property": "heading_3"}}, {"content_block": {"content": "Copertura assicurativa (INAIL, RC)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Riservatezza e NDA", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Orario di lavoro, permessi, assenze", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Rimborsi spese (se previsti)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Valutazione", "block_property": "heading_3"}}, {"content_block": {"content": "**Valutazione intermedia**: Feedback del tutor aziendale", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Valutazione finale**: Scheda di valutazione aziendale", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Presentazione**: Alla commissione d'esame", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. Obiettivi Formativi", "block_property": "heading_3"}}, {"content_block": {"content": "Applicazione pratica di competenze cloud (AWS/Azure/GCP)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "DevOps, CI/CD, containerizzazione, orchestrazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Programmazione e automazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Lavoro in team, metodologie agili", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Conoscenza dei processi aziendali", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "Lo stage è **obbligatorio** per il conseguimento del diploma ITS", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "La **ricerca azienda** va iniziata con largo anticipo (vedi 00_Amministrazione_Corso)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Mantenere contatto costante con **tutor didattico** durante tutto il periodo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Compilare **timesheet** regolarmente (non a fine stage)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "La **relazione finale** è parte integrante dell'esame", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materie collegate**: `00_Amministrazione_Corso`, `02_Orientamento_e_Soft_Skills`, `23_Project_Work_e_Laboratori`", "block_property": "bulleted_list_item"}}]}}]