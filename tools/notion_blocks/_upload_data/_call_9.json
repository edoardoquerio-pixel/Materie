{"tool_slug":"NOTION_ADD_MULTIPLE_PAGE_CONTENT","arguments":{"parent_block_id":"391f85d3-4899-81d5-abd4-edbcdba6ec21","content_blocks":[{"content_block":{"content":"# 15_Cloud_GCP","block_property":"paragraph"}},{"content_block":{"content":"📋 Panoramica","block_property":"heading_2"}},{"content_block":{"content":"Cloud computing su Google Cloud Platform. Suite di servizi cloud con punti di forza in data analytics, AI/ML, Kubernetes (GKE), networking globale (Andromeda) e serverless.","block_property":"paragraph"}},{"content_block":{"content":"> ⚠️ **Nessun materiale didattico presente** in `01_Materiale/`. Questa nota è un placeholder da integrare.","block_property":"paragraph"}},{"content_block":{"content":"📚 Indice degli argomenti (attesi dal syllabus)","block_property":"heading_2"}},{"content_block":{"content":"1. Fondamenti GCP","block_property":"heading_3"}},{"content_block":{"content":"Regions, Zones, Global resources","block_property":"bulleted_list_item"}},{"content_block":{"content":"Gerarchia risorse: Organization → Folder → Project → Resources","block_property":"bulleted_list_item"}},{"content_block":{"content":"GCP Console, Cloud Shell, Cloud SDK (gcloud), Client Libraries","block_property":"bulleted_list_item"}},{"content_block":{"content":"2. Identità e Sicurezza","block_property":"heading_3"}},{"content_block":{"content":"**Cloud IAM**: Roles (primitive/predefined/custom), Service Accounts, Policy","block_property":"bulleted_list_item"}},{"content_block":{"content":"**Cloud KMS**: Key management, CMEK, CSEK","block_property":"bulleted_list_item"}},{"content_block":{"content":"**Security Command Center**: Remediation e vulnerability scanning","block_property":"bulleted_list_item"}},{"content_block":{"content":"**VPC Service Controls**: Perimeter security","block_property":"bulleted_list_item"}},{"content_block":{"content":"3. Compute","block_property":"heading_3"}},{"content_block":{"content":"**Compute Engine**: VM, machine types, sole-tenant nodes, preemptible/spot","block_property":"bulleted_list_item"}},{"content_block":{"content":"**GKE (Google Kubernetes Engine)**: Managed K8s, Autopilot vs Standard, Workload Identity","block_property":"bulleted_list_item"}},{"content_block":{"content":"**Cloud Run**: Container serverless (Knative-based)","block_property":"bulleted_list_item"}},{"content_block":{"content":"**Cloud Functions**: Function-as-a-Service (Gen 1 e Gen 2)","block_property":"bulleted_list_item"}},{"content_block":{"content":"**App Engine**: PaaS tradizionale (standard/flexible)","block_property":"bulleted_list_item"}},{"content_block":{"content":"4. Storage e Database","block_property":"heading_3"}},{"content_block":{"content":"**Cloud Storage**: Bucket, classi (Standard, Nearline, Coldline, Archive), object versioning","block_property":"bulleted_list_item"}},{"content_block":{"content":"**Cloud SQL**: MySQL, PostgreSQL, SQL Server managed","block_property":"bulleted_list_item"}},{"content_block":{"content":"**Cloud Spanner**: DB relazionale orizzontalmente scalabile","block_property":"bulleted_list_item"}},{"content_block":{"content":"**Firestore / Bigtable**: NoSQL document/wide-column","block_property":"bulleted_list_item"}},{"content_block":{"content":"**BigQuery**: Data warehouse serverless (SQL analytics su petabyte)","block_property":"bulleted_list_item"}},{"content_block":{"content":"5. Networking","block_property":"heading_3"}},{"content_block":{"content":"**VPC**: Subnet mode (auto/custom), firewall rules, Cloud NAT","block_property":"bulleted_list_item"}},{"content_block":{"content":"**Cloud Interconnect / VPN**: Hybrid connectivity","block_property":"bulleted_list_item"}},{"content_block":{"content":"**Cloud CDN**: Content delivery","block_property":"bulleted_list_item"}},{"content_block":{"content":"**Cloud DNS**: Managed DNS","block_property":"bulleted_list_item"}},{"content_block":{"content":"**Cloud Load Balancing**: Multi-region, anycast IP","block_property":"bulleted_list_item"}},{"content_block":{"content":"6. AI/ML e Dati","block_property":"heading_3"}},{"content_block":{"content":"**Vertex AI**: ML piattaforma unificata (AutoML, custom training, predictions)","block_property":"bulleted_list_item"}},{"content_block":{"content":"**Dataflow**: Stream/batch processing (Apache Beam)","block_property":"bulleted_list_item"}},{"content_block":{"content":"**Dataproc**: Managed Hadoop/Spark","block_property":"bulleted_list_item"}},{"content_block":{"content":"**Pub/Sub**: Messaggistica asincrona","block_property":"bulleted_list_item"}},{"content_block":{"content":"⚡ Punti Chiave","block_property":"heading_2"}},{"content_block":{"content":"GCP è leader in **data analytics e AI/ML** (BigQuery, Vertex AI)","block_property":"bulleted_list_item"}},{"content_block":{"content":"**GKE** è il managed Kubernetes più maturo dei tre cloud","block_property":"bulleted_list_item"}},{"content_block":{"content":"**Cloud Run** esegue container serverless con fatturazione al secondo","block_property":"bulleted_list_item"}},{"content_block":{"content":"La gerarchia **Organization → Folder → Project → Resources** è unica di GCP","block_property":"bulleted_list_item"}},{"content_block":{"content":"**BigQuery** separa storage e compute — paga per storage e query eseguite","block_property":"bulleted_list_item"}},{"content_block":{"content":"📎 Risorse Collegate","block_property":"heading_2"}},{"content_block":{"content":"**02_Esercizi/**: —","block_property":"bulleted_list_item"}},{"content_block":{"content":"**03_Progetti/**: —","block_property":"bulleted_list_item"}},{"content_block":{"content":"**Materie collegate**: `23_Project_Work_e_Laboratori`, `14_Cloud_Azure`, `13_Cloud_AWS`, `20_Data_Analytics_Visualization`","block_property":"bulleted_list_item"}}]}}