[{"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-819e-a65d-f0c83d7a133f", "content_blocks": [{"content_block": {"content": "# [12] RESTful API", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Materia dedicata alla progettazione e implementazione di API RESTful. Si costruisce progressivamente una libreria online partendo da semplici array in memoria fino a database SQLite con autenticazione JWT e Swagger.", "block_property": "paragraph"}}, {"content_block": {"content": "**Tecnologie**: Node.js (Express), SQLite, Swagger/OpenAPI, JWT, HTTPS, body-parser, ESM (ECMAScript Modules)", "block_property": "paragraph"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Fondamenti REST", "block_property": "heading_3"}}, {"content_block": {"content": "**REST** (Representational State Transfer): architettura stateless basata su risorse", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Verbi HTTP**: GET (leggi), POST (crea), PUT (aggiorna completo), PATCH (aggiorna parziale), DELETE (elimina)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Stateless**: ogni richiesta contiene tutte le info necessarie", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**URI risorse**: `/api/v1/libri`, `/api/v1/libri/123`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Codici di stato**: 200 OK, 201 Created, 204 No Content, 400 Bad Request, 401 Unauthorized, 404 Not Found, 500 Server Error", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. JSON e Formato Dati", "block_property": "heading_3"}}, {"content_block": {"content": "{", "block_property": "paragraph"}}, {"content_block": {"content": "  \"id\": 1,", "block_property": "paragraph"}}, {"content_block": {"content": "  \"titolo\": \"Il Nome della Rosa\",", "block_property": "paragraph"}}, {"content_block": {"content": "  \"autore\": \"Umberto Eco\",", "block_property": "paragraph"}}, {"content_block": {"content": "  \"anno\": 1980", "block_property": "paragraph"}}, {"content_block": {"content": "}", "block_property": "paragraph"}}, {"content_block": {"content": "**Content-Type**: `application/json`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Request/Response** strutturati e consistenti", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Progettazione API", "block_property": "heading_3"}}, {"content_block": {"content": "**URL naming**: sostantivi plurali (`/libri`, non `/libro`)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Filtri**: `GET /api/libri?autore=Eco&anno=1980`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Paginazione**: `GET /api/libri?page=1&limit=10`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Versioning**: `/api/v1/...`, `/api/v2/...`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Implementazione con Express (Node.js)", "block_property": "heading_3"}}, {"content_block": {"content": "import express from 'express';", "block_property": "paragraph"}}, {"content_block": {"content": "import bodyParser from 'body-parser';", "block_property": "paragraph"}}, {"content_block": {"content": "const app = express();", "block_property": "paragraph"}}, {"content_block": {"content": "app.use(bodyParser.json());", "block_property": "paragraph"}}, {"content_block": {"content": "const PORT = 3000;", "block_property": "paragraph"}}, {"content_block": {"content": "// GET tutti i libri", "block_property": "paragraph"}}, {"content_block": {"content": "app.get('/api/v1/libri', (req, res) => {", "block_property": "paragraph"}}, {"content_block": {"content": "  res.json(libri);", "block_property": "paragraph"}}, {"content_block": {"content": "});", "block_property": "paragraph"}}, {"content_block": {"content": "// POST nuovo libro", "block_property": "paragraph"}}, {"content_block": {"content": "app.post('/api/v1/libri', (req, res) => {", "block_property": "paragraph"}}, {"content_block": {"content": "  const nuovoLibro = { id: nextId++, ...req.body };", "block_property": "paragraph"}}, {"content_block": {"content": "  libri.push(nuovoLibro);", "block_property": "paragraph"}}, {"content_block": {"content": "  res.status(201).json(nuovoLibro);", "block_property": "paragraph"}}, {"content_block": {"content": "});", "block_property": "paragraph"}}, {"content_block": {"content": "app.listen(PORT, () => console.log(`Server su porta ${PORT}`));", "block_property": "paragraph"}}, {"content_block": {"content": "**Evoluzione**: v1 (array in memoria) → v2 (SQLite persistente)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Middleware**: body-parser, logger, CORS, auth", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. SQLite come Storage", "block_property": "heading_3"}}, {"content_block": {"content": "import sqlite3 from 'sqlite3';", "block_property": "paragraph"}}, {"content_block": {"content": "const db = new sqlite3.Database('libreria.db');", "block_property": "paragraph"}}, {"content_block": {"content": "db.run(`CREATE TABLE IF NOT EXISTS libri (", "block_property": "paragraph"}}, {"content_block": {"content": "  id INTEGER PRIMARY KEY AUTOINCREMENT,", "block_property": "paragraph"}}, {"content_block": {"content": "  titolo TEXT NOT NULL,", "block_property": "paragraph"}}, {"content_block": {"content": "  autore TEXT NOT NULL,", "block_property": "paragraph"}}, {"content_block": {"content": "  anno INTEGER", "block_property": "paragraph"}}, {"content_block": {"content": ")`);", "block_property": "paragraph"}}, {"content_block": {"content": "6. HTTPS / JWT / Autenticazione", "block_property": "heading_3"}}, {"content_block": {"content": "**HTTPS**: TLS/SSL per crittografia del canale", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**JWT** (JSON Web Token): autenticazione stateless", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "  Header.Payload.Signature", "block_property": "paragraph"}}, {"content_block": {"content": "**Flusso**: login → JWT → token in `Authorization: Bearer <token>`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Middleware di autenticazione**: `jwt.verify(token, secret)`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**JWT vs HttpOnly Cookie**: JWT per SPA/mobile, cookie per SSR", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "7. Swagger / OpenAPI", "block_property": "heading_3"}}, {"content_block": {"content": "Documentazione automatica delle API", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Formato: `swagger.json` (OpenAPI 2.0) o `openapi.yaml` (3.0)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "UI interattiva: `swagger-ui-express`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Try it out**: test diretto dalla documentazione", "block_property": "bulleted_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**REST non è CRUD**: i verbi HTTP esprimono azioni, non solo operazioni database", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Versiona le API**: non rompere i client esistenti", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Valida sempre input**: mai fidarsi di req.body", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Usa HTTPS in produzione**: sempre, sempre, sempre", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Password mai in chiaro**: hashing con bcrypt, non scrivere in DB", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Middleware**: incapsula auth, log, errori in middleware riutilizzabili", "block_property": "numbered_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/** — Esercizi su routing, middleware, database", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/** — LibreriaOnline (v1, v2.1, v2.2, v2-final), MUSICLAB", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materiale**: PDF lezioni 1-5, guida HTML, Swagger, JWT, test DOCX", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-81c1-b869-c8471dd1f298", "content_blocks": [{"content_block": {"content": "# 13_Cloud_AWS", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Cloud computing su Amazon Web Services. Piattaforma cloud leader di mercato con oltre 200 servizi tra compute, storage, database, networking, AI/ML e sicurezza.", "block_property": "paragraph"}}, {"content_block": {"content": "> ⚠️ **Nessun materiale didattico presente** in `01_Materiale/`. Questa nota è un placeholder da integrare.", "block_property": "paragraph"}}, {"content_block": {"content": "📚 Indice degli argomenti (attesi dal syllabus)", "block_property": "heading_2"}}, {"content_block": {"content": "1. Fondamenti AWS", "block_property": "heading_3"}}, {"content_block": {"content": "Global infrastructure: Regions, AZs, Edge Locations", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "AWS Management Console, CLI, SDK", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "IAM: Users, Groups, Roles, Policies (JSON)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Compute", "block_property": "heading_3"}}, {"content_block": {"content": "**EC2**: Tipi di istanza, AMI, security groups, EBS, ELB, Auto Scaling", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Lambda**: Serverless, trigger, runtime, billing per invocazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**ECS / EKS**: Container orchestration (Fargate vs EC2)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Storage", "block_property": "heading_3"}}, {"content_block": {"content": "**S3**: Bucket, classi storage, lifecycle, versioning, replication", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**EBS**: Volumi, snapshot, encryption", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**EFS**: File system condiviso NFS", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Database", "block_property": "heading_3"}}, {"content_block": {"content": "**RDS**: MySQL, PostgreSQL, MariaDB, SQL Server, Oracle", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**DynamoDB**: NoSQL key-value/document", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**ElastiCache**: Redis, Memcached", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. Networking", "block_property": "heading_3"}}, {"content_block": {"content": "**VPC**: Subnet, route tables, Internet Gateway, NAT Gateway", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Security Groups vs NACL**", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**CloudFront**: CDN", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Route 53**: DNS", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "6. Sicurezza e Monitoring", "block_property": "heading_3"}}, {"content_block": {"content": "**CloudWatch**: Logs, metrics, alarms", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**CloudTrail**: Audit API calls", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**AWS Shield / WAF**: Protezione DDoS e firewall applicativo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**KMS**: Key management, encryption", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "AWS ha il **market share maggiore** nel cloud (≈32% Q1 2025)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**IAM** è il fondamento della sicurezza — seguire il principio del minimo privilegio", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**S3** è storage object, non file system (consistenza read-after-write)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Lambda** si paga per invocazione e durata (arrotondato a 1ms)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Tutti i servizi possono essere gestiti via **Infrastructure as Code** (CloudFormation/Terraform)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materie collegate**: `23_Project_Work_e_Laboratori`, `19_Virtualizzazione`, `14_Cloud_Azure`, `15_Cloud_GCP`", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-815b-874f-e8ab58373558", "content_blocks": [{"content_block": {"content": "# [14] Cloud Azure", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Materia dedicata a Microsoft Azure con copertura completa: architettura, identità/governance, reti virtuali, compute (VM, App Service, Functions, Container/AKS), storage, AI/Foundry e security/BC/DR. 18 moduli progressivi con slide.", "block_property": "paragraph"}}, {"content_block": {"content": "**Tecnologie**: Microsoft Azure, Entra ID, Virtual Network, VM, App Service, Functions, AKS, Blob Storage, AI Foundry, Defender, Key Vault, Backup/DR", "block_property": "paragraph"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Introduzione ad Azure", "block_property": "heading_3"}}, {"content_block": {"content": "**Cos'è il cloud computing**: IaaS, PaaS, SaaS", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Modelli di deployment**: pubblico, privato, ibrido", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Regioni e zone di disponibilità**: replicazione geografica, residenza dati", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**SLA**: 99.9% → 99.999% a seconda della configurazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Architettura e Strumenti di Accesso (2-3)", "block_property": "heading_3"}}, {"content_block": {"content": "**Azure Portal**: GUI web", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Azure CLI / PowerShell**: automazione e scripting", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Azure Resource Manager (ARM)**: API unificata per provisioning", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Azure Arc**: gestione risorse on-premise e multi-cloud", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Blueprint**: template di conformità", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Identity e Governance (4-5)", "block_property": "heading_3"}}, {"content_block": {"content": "**Microsoft Entra ID** (ex Azure AD): directory tenant, SSO, MFA", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**RBAC** (Role-Based Access Control): ruoli, scope, azioni consentite", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Policy**: regole di governance per risorse", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Management Groups**: gerarchia di sottoscrizioni", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Privileged Identity Management (PIM)**: accesso JIT a ruoli privilegiati", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Reti su Azure (6-8)", "block_property": "heading_3"}}, {"content_block": {"content": "**Virtual Network (VNet)**: isolamento rete, addressing, subnets", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Peering VNet**: connessione tra VNet (stessa regione o cross-region)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**VPN Gateway**: sito-sito, punto-sito", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Azure DNS**: risoluzione nomi", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Load Balancer**: pubblico/interno, livello 4", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Application Gateway**: WAF, routing livello 7", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Azure Front Door / Traffic Manager**: routing globale", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. Compute: VM, App Service, Functions (9-12)", "block_property": "heading_3"}}, {"content_block": {"content": "**Virtual Machines**: IaaS, immagini, scaling set, dischi (managed/unmanaged)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**App Service**: PaaS per web app, auto-scaling, slot deployment", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Azure Functions**: serverless, trigger (HTTP, timer, queue), Durable Functions", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Container Instances / AKS**: container PaaS / Kubernetes orchestrato", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Opzioni scaling**: verticale (VM più grande) vs orizzontale (più istanze)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "6. Storage e Dati (13-14, 16)", "block_property": "heading_3"}}, {"content_block": {"content": "**Blob Storage**: dati non strutturati (hot/cool/archive tier)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**File Storage**: condivisioni SMB, Azure File Sync", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Disk Storage**: SSD/HDD managed per VM", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Sicurezza storage**: crittografia lato server/ client, SAS tokens, firewall", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Database gestiti**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "- **Azure SQL**: SQL Server managed", "block_property": "paragraph"}}, {"content_block": {"content": "- **Cosmos DB**: NoSQL globale, multi-model (document, graph, key-value, column-family)", "block_property": "paragraph"}}, {"content_block": {"content": "- **Data Integration**: Data Factory, Synapse Analytics", "block_property": "paragraph"}}, {"content_block": {"content": "7. AI su Azure (15)", "block_property": "heading_3"}}, {"content_block": {"content": "**Azure AI Foundry**: portale per modelli AI (OpenAI, vision, speech)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**AI Services**: Vision, Language, Speech, Decision", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**GitHub Copilot**: AI pair programmer (parte del modulo)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Cognitive Search**: ricerca semantica con AI enrichment", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "8. Security, Reliability, BC/DR (17-18)", "block_property": "heading_3"}}, {"content_block": {"content": "**Microsoft Defender for Cloud**: security posture, vulnerability assessment", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Key Vault**: gestione di secret, chiavi, certificati", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Azure Backup**: backup di VM, file, database", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Disaster Recovery**: Site Recovery per failover regionale", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Business Continuity**: RPO, RTO, SLA planning", "block_property": "bulleted_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**Tutto in Azure è un Resource Group**: raggruppa risorse per ciclo di vita", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**RBAC è il metodo primario di autorizzazione**: minimo privilegio sempre", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Reti**: VNet sono isolate di default — peering per connetterle", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Costi**: Prestare attenzione ai tier di storage, VM dimensionamento, egress", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Sicurezza**: Key Vault per secret, Defender per posture, MFA sempre", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Backup non è DR**: backup protegge da cancellazione, DR da disastro regionale", "block_property": "numbered_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/** — Laboratori Azure", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/** — Progetti con Azure Functions v2 (Python)", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-81d5-abd4-edbcdba6ec21", "content_blocks": [{"content_block": {"content": "# 15_Cloud_GCP", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Cloud computing su Google Cloud Platform. Suite di servizi cloud con punti di forza in data analytics, AI/ML, Kubernetes (GKE), networking globale (Andromeda) e serverless.", "block_property": "paragraph"}}, {"content_block": {"content": "> ⚠️ **Nessun materiale didattico presente** in `01_Materiale/`. Questa nota è un placeholder da integrare.", "block_property": "paragraph"}}, {"content_block": {"content": "📚 Indice degli argomenti (attesi dal syllabus)", "block_property": "heading_2"}}, {"content_block": {"content": "1. Fondamenti GCP", "block_property": "heading_3"}}, {"content_block": {"content": "Regions, Zones, Global resources", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Gerarchia risorse: Organization → Folder → Project → Resources", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "GCP Console, Cloud Shell, Cloud SDK (gcloud), Client Libraries", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Identità e Sicurezza", "block_property": "heading_3"}}, {"content_block": {"content": "**Cloud IAM**: Roles (primitive/predefined/custom), Service Accounts, Policy", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Cloud KMS**: Key management, CMEK, CSEK", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Security Command Center**: Remediation e vulnerability scanning", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**VPC Service Controls**: Perimeter security", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Compute", "block_property": "heading_3"}}, {"content_block": {"content": "**Compute Engine**: VM, machine types, sole-tenant nodes, preemptible/spot", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**GKE (Google Kubernetes Engine)**: Managed K8s, Autopilot vs Standard, Workload Identity", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Cloud Run**: Container serverless (Knative-based)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Cloud Functions**: Function-as-a-Service (Gen 1 e Gen 2)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**App Engine**: PaaS tradizionale (standard/flexible)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Storage e Database", "block_property": "heading_3"}}, {"content_block": {"content": "**Cloud Storage**: Bucket, classi (Standard, Nearline, Coldline, Archive), object versioning", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Cloud SQL**: MySQL, PostgreSQL, SQL Server managed", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Cloud Spanner**: DB relazionale orizzontalmente scalabile", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Firestore / Bigtable**: NoSQL document/wide-column", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**BigQuery**: Data warehouse serverless (SQL analytics su petabyte)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. Networking", "block_property": "heading_3"}}, {"content_block": {"content": "**VPC**: Subnet mode (auto/custom), firewall rules, Cloud NAT", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Cloud Interconnect / VPN**: Hybrid connectivity", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Cloud CDN**: Content delivery", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Cloud DNS**: Managed DNS", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Cloud Load Balancing**: Multi-region, anycast IP", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "6. AI/ML e Dati", "block_property": "heading_3"}}, {"content_block": {"content": "**Vertex AI**: ML piattaforma unificata (AutoML, custom training, predictions)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Dataflow**: Stream/batch processing (Apache Beam)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Dataproc**: Managed Hadoop/Spark", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Pub/Sub**: Messaggistica asincrona", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "GCP è leader in **data analytics e AI/ML** (BigQuery, Vertex AI)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**GKE** è il managed Kubernetes più maturo dei tre cloud", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Cloud Run** esegue container serverless con fatturazione al secondo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "La gerarchia **Organization → Folder → Project → Resources** è unica di GCP", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**BigQuery** separa storage e compute — paga per storage e query eseguite", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materie collegate**: `23_Project_Work_e_Laboratori`, `14_Cloud_Azure`, `13_Cloud_AWS`, `20_Data_Analytics_Visualization`", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-8134-b874-c7a7e212f139", "content_blocks": [{"content_block": {"content": "# 16_Linux_Server_e_Amministrazione", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Amministrazione di server Linux con Debian/Ubuntu. Copre installazione, comandi essenziali, gestione utenti/permessi, SSH, DNS, web server (Apache/Nginx), MySQL/MariaDB, PHP, firewall (iptables/nftables), shell avanzata (grep, sed, awk), strumenti di diagnostica, networking Linux, WordPress deployment, cron e automazione. Docente: Wolfgang Cecchin.", "block_property": "paragraph"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Installazione e Architetture", "block_property": "heading_3"}}, {"content_block": {"content": "**Architetture server**: Fisico, VM, Container, Cloud, Serverless", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Distribuzioni Linux**: Famiglie RedHat (Fedora/CentOS), Debian (Ubuntu), SuSE, Arch, Gentoo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Installazione Debian**: Partizionamento, LVM, filesystem, pacchetti base", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**VM su VMware/VirtualBox/KVM**: Setup e configurazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Comandi Essenziali", "block_property": "heading_3"}}, {"content_block": {"content": "**Struttura comandi**: `comando [opzioni] [parametri]` (es. `ls -lah /home`)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Filesystem**: `/`, `/home`, `/etc`, `/var`, `/tmp`, `/usr`, `/bin`, `/sbin`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Shell**: bash, autocomplete (Tab), history (↑↓), `CTRL+D` (logout), `CTRL+C` (interrompi)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**File operazioni**: `touch`, `cat`, `nano`/`vi`, `cp`, `mv`, `rm`, `mkdir`, `chmod`, `chown`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Redirezione**: `>` (sovrascrivi), `>>` (append), `|` (pipe)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Manuali**: `man comando`, `comando --help`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Utenti, Permessi e SSH", "block_property": "heading_3"}}, {"content_block": {"content": "**Utenti**: `useradd`, `usermod`, `userdel`, `passwd`, `/etc/passwd`, `/etc/shadow`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Permessi**: rwx (444/644/755/700), `chmod` (ottale e simbolico), `chown`, `chgrp`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**SU e Sudo**: `su - utente`, configurazione `/etc/sudoers`, gruppo `sudo`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Permessi speciali**: SUID (4xxx), SGID (2xxx), Sticky Bit (1xxx)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**SSH**: `ssh user@host`, chiavi pubbliche/private (Ed25519/RSA), `~/.ssh/authorized_keys`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Configurazione SSH**: `/etc/ssh/sshd_config`, porta, PermitRootLogin, PasswordAuthentication", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. DNS e Nomi Host", "block_property": "heading_3"}}, {"content_block": {"content": "**hostname**: `hostnamectl`, `/etc/hostname`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**/etc/hosts**: Risoluzione locale nomi-IP", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**DNS client**: `/etc/resolv.conf`, `systemd-resolved`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**named (BIND)**: Concetti base, zone file", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. Web Server (Apache/Nginx)", "block_property": "heading_3"}}, {"content_block": {"content": "**Apache2**: Installazione, `sites-available`/`sites-enabled`, VirtualHost, `.htaccess`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Moduli**: mod_rewrite, mod_ssl, mod_proxy", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Nginx**: Configurazione, server blocks, proxy inverso, SSL/TLS", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Esercizi**: Hosting multiplo, HTTPS self-signed, reverse proxy PHP", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "6. Database MySQL/MariaDB", "block_property": "heading_3"}}, {"content_block": {"content": "**Installazione**: `apt install mariadb-server`, `mysql_secure_installation`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Comandi SQL**: `CREATE DATABASE`, `CREATE USER`, `GRANT`, `SELECT`, `INSERT`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Backup/Ripristino**: `mysqldump`, `mysql < backup.sql`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**WordPress**: Configurazione LAMP/LNMP, `wp-config.php`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "7. PHP", "block_property": "heading_3"}}, {"content_block": {"content": "**Installazione**: `php`, `php-fpm`, `php-mysql`, moduli comuni", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Configurazione**: `php.ini`, pooling FPM, integrazione con Apache/Nginx", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "8. Shell Avanzata e Scripting", "block_property": "heading_3"}}, {"content_block": {"content": "**grep, sed, awk**: Ricerca, sostituzione, elaborazione testo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**find**: Ricerca avanzata file (nome, tipo, dimensione, data)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Espressioni regolari**: Pattern matching in grep/sed/awk", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Cron e at**: Pianificazione task ricorrenti (`crontab -e`) e singoli (`at`)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Script bash**: `#!/bin/bash`, variabili, `if/for/while`, funzioni", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "9. Networking e Firewall", "block_property": "heading_3"}}, {"content_block": {"content": "**Schede di rete**: `ip a`, `ip route`, `ss`, `ping`, `traceroute`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Firewall**: `iptables`/`nftables`, catene, regole, NAT, port forwarding", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Diagnostica**: `tcpdump`, `netstat`, `ss`, `lsof`, `nslookup`, `dig`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Networking Linux**: Bridge, bonding, VLAN su Linux", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "10. Diagnostica e Monitoraggio", "block_property": "heading_3"}}, {"content_block": {"content": "**glances**: Monitoraggio sistema completo (CPU, RAM, disco, rete)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Strumenti diagnostici**: `dmesg`, `journalctl`, `top`/`htop`, `df`/`du`, `free`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Troubleshooting**: `strace`, `lsof`, `systemctl status`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "11. Deployment WordPress", "block_property": "heading_3"}}, {"content_block": {"content": "**Architettura due macchine**: Web server + DB server separati", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Configurazione**: VirtualHost, database remoto, permalink, sicurezza", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Esercizi**: Migrazione, backup, aggiornamento", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**Debian** è la distribuzione di riferimento per il corso (famiglia stable/testing)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Distinguere tra permessi **ottali** (chmod 755) e **simbolici** (chmod u+x)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**SSH con chiavi** è più sicuro della password — usare `ssh-keygen -t ed25519`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "`iptables` è legacy → **nftables** è il successore moderne", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**mysqldump** è essenziale per backup DB: `mysqldump -u root -p db > backup.sql`", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Il piping (`|`) è il cuore della filosofia Unix — componi comandi semplici", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "WordPress: configurare permalink e .htaccess subito dopo installazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/**: Esercizi su utenti/permessi, ripasso meta-corso, find, grep/sed/awk", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materie collegate**: `17_Container_Docker_Kubernetes`, `19_Virtualizzazione`, `06_Reti_e_Sicurezza_Informatica`, `14_Cloud_Azure`", "block_property": "bulleted_list_item"}}]}}]