[{"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-81d3-bd2b-ee7dfa6cd2b8", "content_blocks": [{"content_block": {"content": "# [17] Container Docker Kubernetes", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Materia su containerizzazione e orchestrazione. Copre Docker (immagini, container, Compose) e Kubernetes (pod, deployment, service, scaling). Repository come submodule Git separato.", "block_property": "paragraph"}}, {"content_block": {"content": "**Tecnologie**: Docker, Docker Compose, Kubernetes (kubectl, YAML), Draw.io (diagrams)", "block_property": "paragraph"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Docker — Fondamenti", "block_property": "heading_3"}}, {"content_block": {"content": "**Cos'è un container**: processo isolato, stesso kernel dell'host, leggero vs VM", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Immagine vs Container**: immagine = template, container = istanza in esecuzione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Dockerfile**: ricetta per costruire un'immagine", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Docker — Comandi Principali", "block_property": "heading_3"}}, {"content_block": {"content": "docker build -t mia-app:latest .    # costruisci immagine", "block_property": "paragraph"}}, {"content_block": {"content": "docker run -d -p 8080:80 mia-app    # avvia container", "block_property": "paragraph"}}, {"content_block": {"content": "docker ps                           # container attivi", "block_property": "paragraph"}}, {"content_block": {"content": "docker images                       # immagini locali", "block_property": "paragraph"}}, {"content_block": {"content": "docker exec -it <id> /bin/sh        # shell nel container", "block_property": "paragraph"}}, {"content_block": {"content": "docker logs <id>                    # log container", "block_property": "paragraph"}}, {"content_block": {"content": "docker stop <id>                    # ferma container", "block_property": "paragraph"}}, {"content_block": {"content": "docker compose up -d                # multi-container", "block_property": "paragraph"}}, {"content_block": {"content": "3. Docker Compose", "block_property": "heading_3"}}, {"content_block": {"content": "version: '3'", "block_property": "paragraph"}}, {"content_block": {"content": "services:", "block_property": "paragraph"}}, {"content_block": {"content": "  web:", "block_property": "paragraph"}}, {"content_block": {"content": "    build: ./app", "block_property": "paragraph"}}, {"content_block": {"content": "    ports:", "block_property": "paragraph"}}, {"content_block": {"content": "      - \"8080:80\"", "block_property": "paragraph"}}, {"content_block": {"content": "  db:", "block_property": "paragraph"}}, {"content_block": {"content": "    image: postgres:15", "block_property": "paragraph"}}, {"content_block": {"content": "    environment:", "block_property": "paragraph"}}, {"content_block": {"content": "      POSTGRES_PASSWORD: secret", "block_property": "paragraph"}}, {"content_block": {"content": "    volumes:", "block_property": "paragraph"}}, {"content_block": {"content": "      - pgdata:/var/lib/postgresql/data", "block_property": "paragraph"}}, {"content_block": {"content": "volumes:", "block_property": "paragraph"}}, {"content_block": {"content": "  pgdata:", "block_property": "paragraph"}}, {"content_block": {"content": "4. Kubernetes — Architettura", "block_property": "heading_3"}}, {"content_block": {"content": "**Cluster**: Master node (control plane) + Worker nodes", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Componenti master**: API Server, Scheduler, Controller Manager, etcd", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Componenti worker**: Kubelet, kube-proxy, container runtime", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. Kubernetes — Oggetti Principali", "block_property": "heading_3"}}, {"content_block": {"content": "**Pod**: unità minima, 1+ container", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Deployment**: gestione repliche, rolling update, rollback", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Service**: astrazione di rete, bilanciamento carico (ClusterIP, NodePort, LoadBalancer)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**ConfigMap / Secret**: configurazione e dati sensibili", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Ingress**: routing HTTP/HTTPS esterno", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**PersistentVolume (PV/PVC)**: storage persistente", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "apiVersion: apps/v1", "block_property": "paragraph"}}, {"content_block": {"content": "kind: Deployment", "block_property": "paragraph"}}, {"content_block": {"content": "metadata:", "block_property": "paragraph"}}, {"content_block": {"content": "  name: nginx-deployment", "block_property": "paragraph"}}, {"content_block": {"content": "spec:", "block_property": "paragraph"}}, {"content_block": {"content": "  replicas: 3", "block_property": "paragraph"}}, {"content_block": {"content": "  selector:", "block_property": "paragraph"}}, {"content_block": {"content": "    matchLabels:", "block_property": "paragraph"}}, {"content_block": {"content": "      app: nginx", "block_property": "paragraph"}}, {"content_block": {"content": "  template:", "block_property": "paragraph"}}, {"content_block": {"content": "    metadata:", "block_property": "paragraph"}}, {"content_block": {"content": "      labels:", "block_property": "paragraph"}}, {"content_block": {"content": "        app: nginx", "block_property": "paragraph"}}, {"content_block": {"content": "    spec:", "block_property": "paragraph"}}, {"content_block": {"content": "      containers:", "block_property": "paragraph"}}, {"content_block": {"content": "      - name: nginx", "block_property": "paragraph"}}, {"content_block": {"content": "        image: nginx:latest", "block_property": "paragraph"}}, {"content_block": {"content": "        ports:", "block_property": "paragraph"}}, {"content_block": {"content": "        - containerPort: 80", "block_property": "paragraph"}}, {"content_block": {"content": "6. Kubernetes — Comandi", "block_property": "heading_3"}}, {"content_block": {"content": "kubectl get pods                    # lista pod", "block_property": "paragraph"}}, {"content_block": {"content": "kubectl get nodes                   # nodi cluster", "block_property": "paragraph"}}, {"content_block": {"content": "kubectl apply -f deployment.yaml    # deploy", "block_property": "paragraph"}}, {"content_block": {"content": "kubectl delete pod <nome>           # elimina pod", "block_property": "paragraph"}}, {"content_block": {"content": "kubectl logs <pod>                  # log", "block_property": "paragraph"}}, {"content_block": {"content": "kubectl scale deployment/nginx --replicas=5", "block_property": "paragraph"}}, {"content_block": {"content": "kubectl expose deployment/nginx --port=80 --type=LoadBalancer", "block_property": "paragraph"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**Container ≠ VM**: condividono il kernel host, avvio in secondi, leggeri", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Immutabilità**: le immagini non si modificano, si ricostruiscono", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**K8s desidera stato dichiarativo**: scrivi YAML, K8s lo realizza", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Health check**: liveness + readiness probe per resilienza", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Mai hardcodare credenziali**: sempre Secret + ConfigMap", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Submodule**: `17_Container_Docker_Kubernetes/` è su repo separato — `git submodule update --init --recursive`", "block_property": "numbered_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**labs/** — Laboratori Docker e Kubernetes", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**assignments/** — Assignment pratici", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**01_Materiale/** — Slide e risorse", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**appendices/** — Approfondimenti", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-8167-bb25-da8b80b4c575", "content_blocks": [{"content_block": {"content": "# 18_Microsoft_365_SharePoint", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Suite Microsoft 365 con focus su SharePoint Online, automazione (Power Automate), PowerApps, Excel (tabelle pivot, formule, Power Query), Word e PowerPoint. Include amministrazione SharePoint Online, sicurezza e tre moduli progressivi.", "block_property": "paragraph"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Microsoft 365 — Moduli 1–3", "block_property": "heading_3"}}, {"content_block": {"content": "**Modulo 1**: Introduzione a M365, licenze, portale admin, utenti e gruppi", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Modulo 2**: Exchange Online, Teams, OneDrive, compliance e security center", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Modulo 3**: SharePoint Online, Power Platform, enterprise mobility", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. SharePoint Online Administration — Moduli 1–3", "block_property": "heading_3"}}, {"content_block": {"content": "**Modulo 1**: Architettura SharePoint, site collections, permessi e condivisione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Modulo 2**: Content types, managed metadata, search, term store", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Modulo 3**: Workflow, automation, governance, hybrid scenarios", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Automazione e Sicurezza — Moduli 1 e 3", "block_property": "heading_3"}}, {"content_block": {"content": "**Power Automate**: Flussi automatici, trigger, connettori, approvazioni", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Esercitazione Power Automate**: Creazione flussi per automazione documenti", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Sicurezza**: Conditional Access, MFA, DLP, retention policies", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Strumenti di Produttività", "block_property": "heading_3"}}, {"content_block": {"content": "**Word**: Documenti collaborativi, stili, sommari, revisioni", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Excel**: Formule (CERCA.VERT, SE, SOMMA.SE, tabelle pivot), Power Query, tutorial", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**PowerPoint**: Presentazioni professionali, template, animazioni", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. PowerApps", "block_property": "heading_3"}}, {"content_block": {"content": "**Esercitazione PowerApp**: Creazione app low-code, connessione a SharePoint/Excel", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Portfolio Corso**: Raccolta esercitazioni e risposte", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**SharePoint Online** è il cuore della collaborazione documentale M365", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Power Automate** permette automazione no-code/low-code tra servizi M365 e terze parti", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Le **tabelle pivot** in Excel sono essenziali per analisi dati rapida", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**PowerApps** si integra nativamente con SharePoint Lists come backend", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "La **sicurezza** in M365 si gestisce tramite Conditional Access e DLP policies", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materie collegate**: `14_Cloud_Azure` (Entra ID), `20_Data_Analytics_Visualization` (Excel)", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-815d-ac35-e7e393001f5e", "content_blocks": [{"content_block": {"content": "# [19] Virtualizzazione", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Materia sulla virtualizzazione di sistemi: memoria, networking, VM e infrastruttura virtuale. Include laboratori pratici con OpenStack e microservizi containerizzati con Docker + Terraform.", "block_property": "paragraph"}}, {"content_block": {"content": "**Tecnologie**: VMware/Hyper-V (concetti), OpenStack, Docker, Terraform (OpenTofu), Python, Node.js", "block_property": "paragraph"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Fondamenti di Virtualizzazione", "block_property": "heading_3"}}, {"content_block": {"content": "**Hypervisor**: Tipo 1 (bare-metal: VMware ESXi, Hyper-V, KVM) vs Tipo 2 (hosted: VirtualBox)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Virtualizzazione della memoria**: MMU virtuale, shadow page table, hardware-assisted (Intel EPT/AMD NPT)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Virtualizzazione di networking**: vSwitch, VLAN, NIC teaming, SR-IOV", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Overhead**: confronto prestazioni native vs virtualizzate", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. VM e OpenStack", "block_property": "heading_3"}}, {"content_block": {"content": "**OpenStack**: cloud OS open-source", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "- **Nova**: compute", "block_property": "paragraph"}}, {"content_block": {"content": "- **Neutron**: networking", "block_property": "paragraph"}}, {"content_block": {"content": "- **Cinder**: block storage", "block_property": "paragraph"}}, {"content_block": {"content": "- **Glance**: immagini", "block_property": "paragraph"}}, {"content_block": {"content": "- **Keystone**: identity", "block_property": "paragraph"}}, {"content_block": {"content": "- **Horizon**: dashboard", "block_property": "paragraph"}}, {"content_block": {"content": "**Flavors**: template di risorse (CPU, RAM, disk)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Tenant/Project**: isolamento multi-tenant", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Docker e Microservizi", "block_property": "heading_3"}}, {"content_block": {"content": "**Esempi pratici** nella cartella `ITS-Docker/`:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "- `LISTA/`: container Python (Flask) per CRUD", "block_property": "paragraph"}}, {"content_block": {"content": "- `API/`: Docker Compose multi-container con Python + dipendenze", "block_property": "paragraph"}}, {"content_block": {"content": "**Microservizi** (Terraform + Docker):", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "- `users/`: microservizio utenti (Node.js + JSON)", "block_property": "paragraph"}}, {"content_block": {"content": "- `post/`: microservizio post (Node.js + JSON)", "block_property": "paragraph"}}, {"content_block": {"content": "- `threads/`: microservizio thread (Node.js + JSON)", "block_property": "paragraph"}}, {"content_block": {"content": "**Terraform per Docker**:", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "terraform {", "block_property": "paragraph"}}, {"content_block": {"content": "  required_providers {", "block_property": "paragraph"}}, {"content_block": {"content": "    docker = {", "block_property": "paragraph"}}, {"content_block": {"content": "      source  = \"kreuzwerker/docker\"", "block_property": "paragraph"}}, {"content_block": {"content": "      version = \"~> 3.9.0\"", "block_property": "paragraph"}}, {"content_block": {"content": "    }", "block_property": "paragraph"}}, {"content_block": {"content": "  }", "block_property": "paragraph"}}, {"content_block": {"content": "}", "block_property": "paragraph"}}, {"content_block": {"content": "resource \"docker_container\" \"app\" {", "block_property": "paragraph"}}, {"content_block": {"content": "  name  = \"microservizio-app\"", "block_property": "paragraph"}}, {"content_block": {"content": "  image = docker_image.app.image_id", "block_property": "paragraph"}}, {"content_block": {"content": "  ports {", "block_property": "paragraph"}}, {"content_block": {"content": "    internal = 3000", "block_property": "paragraph"}}, {"content_block": {"content": "    external = 3000", "block_property": "paragraph"}}, {"content_block": {"content": "  }", "block_property": "paragraph"}}, {"content_block": {"content": "}", "block_property": "paragraph"}}, {"content_block": {"content": "4. WSA-Lab (Windows Server App + Docker + Terraform)", "block_property": "heading_3"}}, {"content_block": {"content": "Progetto completo: applicazione Python containerizzata", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Infrastruttura come codice con Terraform", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "`main.tf` + `outputs.tf` per provisioning automatizzato", "block_property": "bulleted_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**Hypervisor Tipo 1** per produzione (minore overhead, maggiore sicurezza)", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**OpenStack** è complesso ma è lo standard open-source per cloud privato", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Docker per sviluppo, K8s per produzione**: Compose per locale, orchestrazione per cluster", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Terraform**: stato dichiarativo desiderato, piano prima di applicare", "block_property": "numbered_list_item"}}, {"content_block": {"content": "**Microservizi**: ogni servizio ha il suo DB, comunicano via API", "block_property": "numbered_list_item"}}, {"content_block": {"block_property": "divider"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/** — Laboratori virtualizzazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/** — Microservizi Docker, Terraform, OpenStack lab", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**WSA-lab/** — Progetto completo Windows Server App (Docker + Terraform + Python)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**ITS-Docker/** — Esempi Docker Compose e container singoli", "block_property": "bulleted_list_item"}}]}}, {"tool_slug": "NOTION_ADD_MULTIPLE_PAGE_CONTENT", "arguments": {"parent_block_id": "391f85d3-4899-8194-9e8d-f2d3864803c6", "content_blocks": [{"content_block": {"content": "# 20_Data_Analytics_Visualization", "block_property": "paragraph"}}, {"content_block": {"content": "📋 Panoramica", "block_property": "heading_2"}}, {"content_block": {"content": "Data analytics e visualizzazione dati. Copre analisi esplorativa, pulizia dati, regressione (lineare, logistica, logaritmica), alberi di decisione, visualizzazione con Excel (grafici, tabelle pivot, Power Query) e Python (Seaborn), dashboard design, storytelling, espressioni regolari e Google Colab.", "block_property": "paragraph"}}, {"content_block": {"content": "📚 Indice degli argomenti", "block_property": "heading_2"}}, {"content_block": {"content": "1. Fondamenti di Analisi Dati", "block_property": "heading_3"}}, {"content_block": {"content": "**Analisi Esplorativa (EDA)**: Statistiche descrittive, distribuzioni, outlier, correlazioni", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Pulizia dei dati**: Missing values, duplicati, outlier treatment, data normalization", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Esercizio Data Cleaning**: Pratica su dataset Excel con tecniche di pulizia", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "2. Metodi Statistici e Predittivi", "block_property": "heading_3"}}, {"content_block": {"content": "**Regressione Lineare**: Minimi quadrati, R², interpretazione coefficienti", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Regressione Logistica**: Classificazione binaria, sigmoide, log-loss", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Regressione Logaritmica**: Modelli non lineari, trasformazione variabili", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Alberi di Decisione**: Classificazione, regressione, overfitting, pruning", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "3. Excel per Analisi Dati", "block_property": "heading_3"}}, {"content_block": {"content": "**Grafici**: Istogrammi, scatter plot, line chart, box plot", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Tabelle Pivot**: Aggregazione, filtri, slicer, drill-down", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Power Query (v3)**: ETL, merge, append, trasformazioni avanzate", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Dataset Esercizi**: Immobiliare, prestiti, voti fantacalcio, dataset pulizia", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "4. Visualizzazione con Python", "block_property": "heading_3"}}, {"content_block": {"content": "**Google Colab**: Setup, notebook, Python per analisi dati", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Seaborn**: heatmap, pairplot, boxplot, countplot, distplot", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Visualizzazione**: Categorical, distribution, relational plots", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Espressioni Regolari**: Pattern matching per pulizia testo", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "5. Dashboard Design e Storytelling", "block_property": "heading_3"}}, {"content_block": {"content": "**Dashboard Design**: KPI, layout, UX, colori, aggiornamento dati", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Storytelling**: Narrazione dati, contesto, insight, azione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Visualizzazione per Big Data**: Sampling, aggregazione, grafici alternativi", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Teoria della Visualizzazione**: Pre-attentive attributes, gestalt, chart types", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Visualizzazione e Storytelling**: Tecniche per presentazioni efficaci", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "6. Prova Finale", "block_property": "heading_3"}}, {"content_block": {"content": "**Quiz finale**: Test di verifica competenze", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Prova finale**: Esercitazione completa su analisi e visualizzazione", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "⚡ Punti Chiave", "block_property": "heading_2"}}, {"content_block": {"content": "**80% del tempo** va nella pulizia/preparazione dati, solo 20% nell'analisi", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Le **tabelle pivot** sono lo strumento più potente in Excel per aggregazione rapida", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Power Query** automatizza le operazioni ETL ripetitive", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Seaborn** è la libreria Python standard per statistical plotting (basata su matplotlib)", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "In **regressione lineare**, R² indica la quota di varianza spiegata dal modello", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Google Colab** permette di eseguire notebook Python senza setup locale", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "Per dashboard: meno è meglio — 3-5 KPI chiari, non 20 metriche", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "📎 Risorse Collegate", "block_property": "heading_2"}}, {"content_block": {"content": "**02_Esercizi/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**03_Progetti/**: —", "block_property": "bulleted_list_item"}}, {"content_block": {"content": "**Materie collegate**: `10_Programmazione_Python`, `08_Basi_di_Dati_SQL_NoSQL`, `14_Cloud_Azure`", "block_property": "bulleted_list_item"}}]}}]