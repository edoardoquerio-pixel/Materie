[
  {
    "content_block": {
      "content": "# [19] Virtualizzazione",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "📋 Panoramica",
      "block_property": "heading_2"
    }
  },
  {
    "content_block": {
      "content": "Materia sulla virtualizzazione di sistemi: memoria, networking, VM e infrastruttura virtuale. Include laboratori pratici con OpenStack e microservizi containerizzati con Docker + Terraform.",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "**Tecnologie**: VMware/Hyper-V (concetti), OpenStack, Docker, Terraform (OpenTofu), Python, Node.js",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "block_property": "divider"
    }
  },
  {
    "content_block": {
      "content": "📚 Indice degli argomenti",
      "block_property": "heading_2"
    }
  },
  {
    "content_block": {
      "content": "1. Fondamenti di Virtualizzazione",
      "block_property": "heading_3"
    }
  },
  {
    "content_block": {
      "content": "**Hypervisor**: Tipo 1 (bare-metal: VMware ESXi, Hyper-V, KVM) vs Tipo 2 (hosted: VirtualBox)",
      "block_property": "bulleted_list_item"
    }
  },
  {
    "content_block": {
      "content": "**Virtualizzazione della memoria**: MMU virtuale, shadow page table, hardware-assisted (Intel EPT/AMD NPT)",
      "block_property": "bulleted_list_item"
    }
  },
  {
    "content_block": {
      "content": "**Virtualizzazione di networking**: vSwitch, VLAN, NIC teaming, SR-IOV",
      "block_property": "bulleted_list_item"
    }
  },
  {
    "content_block": {
      "content": "**Overhead**: confronto prestazioni native vs virtualizzate",
      "block_property": "bulleted_list_item"
    }
  },
  {
    "content_block": {
      "content": "2. VM e OpenStack",
      "block_property": "heading_3"
    }
  },
  {
    "content_block": {
      "content": "**OpenStack**: cloud OS open-source",
      "block_property": "bulleted_list_item"
    }
  },
  {
    "content_block": {
      "content": "- **Nova**: compute",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "- **Neutron**: networking",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "- **Cinder**: block storage",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "- **Glance**: immagini",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "- **Keystone**: identity",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "- **Horizon**: dashboard",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "**Flavors**: template di risorse (CPU, RAM, disk)",
      "block_property": "bulleted_list_item"
    }
  },
  {
    "content_block": {
      "content": "**Tenant/Project**: isolamento multi-tenant",
      "block_property": "bulleted_list_item"
    }
  },
  {
    "content_block": {
      "content": "3. Docker e Microservizi",
      "block_property": "heading_3"
    }
  },
  {
    "content_block": {
      "content": "**Esempi pratici** nella cartella `ITS-Docker/`:",
      "block_property": "bulleted_list_item"
    }
  },
  {
    "content_block": {
      "content": "- `LISTA/`: container Python (Flask) per CRUD",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "- `API/`: Docker Compose multi-container con Python + dipendenze",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "**Microservizi** (Terraform + Docker):",
      "block_property": "bulleted_list_item"
    }
  },
  {
    "content_block": {
      "content": "- `users/`: microservizio utenti (Node.js + JSON)",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "- `post/`: microservizio post (Node.js + JSON)",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "- `threads/`: microservizio thread (Node.js + JSON)",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "**Terraform per Docker**:",
      "block_property": "bulleted_list_item"
    }
  },
  {
    "content_block": {
      "content": "terraform {",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "  required_providers {",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "    docker = {",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "      source  = \"kreuzwerker/docker\"",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "      version = \"~> 3.9.0\"",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "    }",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "  }",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "}",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "resource \"docker_container\" \"app\" {",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "  name  = \"microservizio-app\"",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "  image = docker_image.app.image_id",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "  ports {",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "    internal = 3000",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "    external = 3000",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "  }",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "}",
      "block_property": "paragraph"
    }
  },
  {
    "content_block": {
      "content": "4. WSA-Lab (Windows Server App + Docker + Terraform)",
      "block_property": "heading_3"
    }
  },
  {
    "content_block": {
      "content": "Progetto completo: applicazione Python containerizzata",
      "block_property": "bulleted_list_item"
    }
  },
  {
    "content_block": {
      "content": "Infrastruttura come codice con Terraform",
      "block_property": "bulleted_list_item"
    }
  },
  {
    "content_block": {
      "content": "`main.tf` + `outputs.tf` per provisioning automatizzato",
      "block_property": "bulleted_list_item"
    }
  },
  {
