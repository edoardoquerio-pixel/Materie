  {
    "content_block": {
      "content": "⚡ Punti Chiave",
      "block_property": "heading_2"
    }
  },
  {
    "content_block": {
      "content": "**Hypervisor Tipo 1** per produzione (minore overhead, maggiore sicurezza)",
      "block_property": "numbered_list_item"
    }
  },
  {
    "content_block": {
      "content": "**OpenStack** è complesso ma è lo standard open-source per cloud privato",
      "block_property": "numbered_list_item"
    }
  },
  {
    "content_block": {
      "content": "**Docker per sviluppo, K8s per produzione**: Compose per locale, orchestrazione per cluster",
      "block_property": "numbered_list_item"
    }
  },
  {
    "content_block": {
      "content": "**Terraform**: stato dichiarativo desiderato, piano prima di applicare",
      "block_property": "numbered_list_item"
    }
  },
  {
    "content_block": {
      "content": "**Microservizi**: ogni servizio ha il suo DB, comunicano via API",
      "block_property": "numbered_list_item"
    }
  },
