  {
    "content_block": {
      "content": "**Entropia** misura la forza di una password — mai sotto 60 bit per account importanti",
      "block_property": "numbered_list_item"
    }
  },
  {
    "content_block": {
      "content": "**Crittografia simmetrica** (AES) per volumi grandi di dati; **asimmetrica** (RSA, DH) per scambio chiavi e firme",
      "block_property": "numbered_list_item"
    }
  },
  {
    "content_block": {
      "content": "**Non si scrivono algoritmi crittografici propri** — usare librerie standard (OpenSSL, Cryptography.io)",
