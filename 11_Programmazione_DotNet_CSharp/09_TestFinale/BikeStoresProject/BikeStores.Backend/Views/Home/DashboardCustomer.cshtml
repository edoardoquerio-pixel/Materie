@{
    ViewData["Title"] = "My Dashboard";
}

<div class = "text-center py-5">
    <h1 class = "mb-4">Welcome, @User.Identity?.Name!</h1>
</div>

<div class = "row g-4">
    <div class = "col-md-6">
        <div class = "card text-bg-dark">
            <div class = "card-body text-center py-5">
                <h5 class = "card-title display-6">@ViewBag.MyOrders</h5>
                <p class = "card-text">My Orders</p>
                <a asp-controller="Orders" asp-action="Index" class = "btn btn-outline-light btn-sm">View Orders</a>
            </div>
        </div>
    </div>
    <div class = "col-md-6">
        <div class = "card">
            <div class = "card-body text-center py-5">
                <h5 class = "card-title">My Profile</h5>
                <p class = "card-text">View and edit personal information</p>
                <a asp-controller="Profile" asp-action="Index" class = "btn btn-dark">View Profile</a>
            </div>
        </div>
    </div>
</div>
