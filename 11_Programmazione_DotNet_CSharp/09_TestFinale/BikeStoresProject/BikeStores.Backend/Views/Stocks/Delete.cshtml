@model BikeStores.Data.Models.Stock

@{
    ViewData["Title"] = "Delete Stock";
}

<h1 class="mb-4">Delete Stock</h1>

<div class="card">
    <div class="card-body">
        <h5 class="text-danger">Are you sure you want to delete this?</h5>
        <dl class="row mb-0">
            <dt class="col-sm-2">Store</dt>
            <dd class="col-sm-10">@Model.Store?.StoreName</dd>
            <dt class="col-sm-2">Product</dt>
            <dd class="col-sm-10">@Model.Product?.ProductName</dd>
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Quantity)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Quantity)</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete">
            <input type="hidden" name="storeId" value="@Model.StoreId" />
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </form>
    </div>
</div>
