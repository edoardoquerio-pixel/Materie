@model BikeStores.Data.Models.Stock

@{
    ViewData["Title"] = "Edit Stock";
}

<h1 class="mb-4">Edit Stock</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="StoreId" />
    <input type="hidden" asp-for="ProductId" />
    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Store</label>
                <p class="form-control-plaintext">@(Model.Store?.StoreName ?? "N/A")</p>
            </div>
            <div class="mb-3">
                <label class="form-label">Product</label>
                <p class="form-control-plaintext">@(Model.Product?.ProductName ?? "N/A")</p>
            </div>
            <div class="mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-dark">Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>
</form>
