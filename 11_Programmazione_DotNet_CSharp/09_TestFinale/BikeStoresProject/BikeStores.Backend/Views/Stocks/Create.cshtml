@model BikeStores.Data.Models.Stock

@{
    ViewData["Title"] = "Create Stock";
}

<h1 class="mb-4">Create Stock</h1>

<form asp-action="Create">
    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="StoreId" class="form-label">Store</label>
                <select asp-for="StoreId" class="form-select" asp-items="ViewBag.StoreId">
                    <option value="">-- Select Store --</option>
                </select>
                <span asp-validation-for="StoreId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ProductId" class="form-label">Product</label>
                <select asp-for="ProductId" class="form-select" asp-items="ViewBag.ProductId">
                    <option value="">-- Select Product --</option>
                </select>
                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-dark">Create</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>
</form>
