@model IEnumerable<BikeStores.Data.Models.Brand>

@{
    ViewData["Title"] = "Brands";
}

<h1 class = "mb-4">Brands</h1>

<p>
    <a asp-action="Create" class = "btn btn-dark">Create New Brand</a>
</p>

<table class = "table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.BrandName)</th>
            <th>@Html.DisplayNameFor(model => model.Products)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.BrandName)</td>
                <td>@Html.DisplayFor(modelItem => item.Products.Count)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.BrandId" class = "btn btn-dark btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.BrandId" class = "btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
