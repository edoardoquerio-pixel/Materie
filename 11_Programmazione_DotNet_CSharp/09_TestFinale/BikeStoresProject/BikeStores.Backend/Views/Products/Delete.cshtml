@model BikeStores.Data.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<h1 class = "mb-4">Delete Product</h1>

<div class = "card">
    <div class = "card-body">
        <h5 class = "text-danger">Are you sure you want to delete this?</h5>
        <dl class = "row mb-0">
            <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.ProductName)</dt>
            <dd class = "col-sm-10">@Html.DisplayFor(model => model.ProductName)</dd>

            <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.Brand)</dt>
            <dd class = "col-sm-10">@Html.DisplayFor(model => model.Brand!.BrandName)</dd>

            <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.Category)</dt>
            <dd class = "col-sm-10">@Html.DisplayFor(model => model.Category!.CategoryName)</dd>

            <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.ListPrice)</dt>
            <dd class = "col-sm-10">@Html.DisplayFor(model => model.ListPrice)</dd>
        </dl>
    </div>
    <div class = "card-footer">
        <form asp-action="Delete">
            <input type="hidden" asp-for="ProductId" />
            <button type="submit" class = "btn btn-danger">Delete</button>
            <a asp-action="Index" class = "btn btn-outline-secondary">Back</a>
        </form>
    </div>
</div>
