@model BikeStores.Data.Models.Order

@{
    ViewData["Title"] = "Delete Order";
}

<h1 class="mb-4">Delete Order</h1>

<div class="card">
    <div class="card-body">
        <h5 class="text-danger">Are you sure you want to delete this?</h5>
        <dl class="row mb-0">
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.OrderId)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.OrderId)</dd>
            <dt class="col-sm-2">Customer</dt>
            <dd class="col-sm-10">@Model.Customer?.FirstName @Model.Customer?.LastName</dd>
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Store)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Store!.StoreName)</dd>
            <dt class="col-sm-2">Staff</dt>
            <dd class="col-sm-10">@Model.Staff?.FirstName @Model.Staff?.LastName</dd>
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.OrderStatus)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.OrderStatus)</dd>
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.OrderDate)</dt>
            <dd class="col-sm-10">@Model.OrderDate.ToShortDateString()</dd>
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.RequiredDate)</dt>
            <dd class="col-sm-10">@Model.RequiredDate.ToShortDateString()</dd>
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ShippedDate)</dt>
            <dd class="col-sm-10">@Model.ShippedDate?.ToShortDateString()</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete">
            <input type="hidden" asp-for="OrderId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </form>
    </div>
</div>
