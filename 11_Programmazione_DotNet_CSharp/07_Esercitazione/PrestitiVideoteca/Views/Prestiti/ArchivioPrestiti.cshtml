@model IEnumerable<PrestitiVideoteca.Models.Prestito>

@{
    ViewData["Title"] = "Archivio Prestiti";
}

<h1>Archivio Prestiti</h1>

<p>
    <a asp-action="Index" class="btn btn-primary">Prestiti Correnti</a>
</p>

<form>
    <p>
        Cerca per <input style="width: 50%" name="search" type="text" value="@ViewBag.Search" placeholder="Titolo film, studente..." />
        <input type="submit" value="Cerca" />
    </p>
</form>

<p>
    Elementi trovati: @ViewBag.TotalRecords
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.DataPrestito)</th>
            <th>@Html.DisplayNameFor(model => model.DataRestituzione)</th>
            <th>@Html.DisplayNameFor(model => model.IdFilmNavigation)</th>
            <th>@Html.DisplayNameFor(model => model.MatricolaNavigation)</th>
            <th class="text-nowrap"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.DataPrestito)</td>
                <td>@Html.DisplayFor(modelItem => item.DataRestituzione)</td>
                <td>@Html.DisplayFor(modelItem => item.IdFilmNavigation.Titolo)</td>
                <td>@Html.DisplayFor(modelItem => item.MatricolaNavigation.Cognome)</td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Dettagli</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Elimina</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center">
    <span>Pagina @ViewBag.PageNumber di @ViewBag.TotalPages</span>
    <div>
        <a asp-action="ArchivioPrestiti"
           asp-route-search="@ViewBag.Search"
           asp-route-pageNumber="@(ViewBag.PageNumber - 1)"
           class="btn btn-outline-secondary @(ViewBag.PageNumber == 1 ? "disabled" : "")">
            Precedente
        </a>
        <a asp-action="ArchivioPrestiti"
           asp-route-search="@ViewBag.Search"
           asp-route-pageNumber="@(ViewBag.PageNumber + 1)"
           class="btn btn-outline-secondary @(ViewBag.PageNumber == ViewBag.TotalPages ? "disabled" : "")">
            Successiva
        </a>
    </div>
</div>
