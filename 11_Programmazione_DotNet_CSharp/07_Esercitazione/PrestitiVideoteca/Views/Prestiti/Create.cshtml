@model PrestitiVideoteca.Models.Prestito

@{
    ViewData["Title"] = "Nuovo Prestito";
}

<h1>@ViewData["Title"]</h1>

<h4>Prestito</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="IdFilm" class="control-label"></label>
                <select asp-for="IdFilm" class ="form-control" asp-items="ViewBag.IdFilm"></select>
            </div>
            <div class="form-group">
                <label asp-for="Matricola" class="control-label"></label>
                <select asp-for="Matricola" class ="form-control" asp-items="ViewBag.Matricola"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Crea" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Torna alla lista</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
