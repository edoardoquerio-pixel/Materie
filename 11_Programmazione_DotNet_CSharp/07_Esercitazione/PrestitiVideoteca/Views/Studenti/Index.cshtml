@model IEnumerable<PrestitiVideoteca.Models.Studente>

@{
    ViewData["Title"] = "Studenti";
}

<h1>Studenti</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Aggiungi Studente</a>
</p>

<form>
    <p>
        Cerca per <input style="width: 50%" name="search" type="text" value="@ViewBag.Search" placeholder="Nome, cognome o classe..." />
        <input type="submit" value="Cerca" />
    </p>
</form>

<p>
    Elementi trovati: @ViewBag.TotalRecords
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nome)</th>
            <th>@Html.DisplayNameFor(model => model.Cognome)</th>
            <th>@Html.DisplayNameFor(model => model.Email)</th>
            <th>@Html.DisplayNameFor(model => model.Classe)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Nome)</td>
            <td>@Html.DisplayFor(modelItem => item.Cognome)</td>
            <td>@Html.DisplayFor(modelItem => item.Email)</td>
            <td>@Html.DisplayFor(modelItem => item.Classe)</td>
            <td class="text-nowrap">
                <a asp-action="Edit" asp-route-id="@item.Matricola" class="btn btn-warning btn-sm">Modifica</a>
                <a asp-action="Details" asp-route-id="@item.Matricola" class="btn btn-info btn-sm">Dettagli</a>
                <a asp-action="Delete" asp-route-id="@item.Matricola" class="btn btn-danger btn-sm">Elimina</a>
            </td>
        </tr>
}
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center">
    <span>Pagina @ViewBag.PageNumber di @ViewBag.TotalPages</span>
    <div>
        <a asp-action="Index"
           asp-route-search="@ViewBag.Search"
           asp-route-pageNumber="@(ViewBag.PageNumber - 1)"
           class="btn btn-outline-secondary @(ViewBag.PageNumber <= 1 ? "disabled" : "")">
           Precedente
        </a>
        <a asp-action="Index"
           asp-route-search="@ViewBag.Search"
           asp-route-pageNumber="@(ViewBag.PageNumber + 1)"
           class="btn btn-outline-secondary @(ViewBag.PageNumber >= ViewBag.TotalPages ? "disabled" : "")">
           Successiva
        </a>
    </div>
</div>
