@model IEnumerable<PrestitiBibliotecaMVC.Models.Prestito>

@{
    ViewData["Title"] = "Elenco Prestiti";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create">Nuovo Prestito</a>
    <a asp-action="PrestitiNonRestituiti">Prestiti Non Restituiti</a>
    <a asp-action="ArchivioPrestiti">Archivio Prestiti</a>
</p>

<form>
    <p>
        Cerca per <input style="width: 50%" id="search" name="search" type="text" value="@ViewBag.Search" placeholder="Cognome o Nome studente, titolo del libro" />
        <input id="Submit1" type="submit" value="Cerca" />
    </p>
</form>

<p>
    Elementi trovati: @Model.Count()
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MatricolaNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdLibroNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataPrestito)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataRestituzione)
            </th>                        
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.MatricolaNavigation.Nominativo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IdLibroNavigation.Titolo)
                </td>
                <td>
                @Html.DisplayFor(modelItem => item.DataPrestito)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataRestituzione)
            </td>            
            <td>
                @if (item.DataRestituzione == null)
                {
                    <a asp-action="RestituisciPrestito" asp-route-id="@item.Id">Restituisci</a>
                } |
                <a asp-action="Edit" asp-route-id="@item.Id">Modifica</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Dettagli</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Elimina</a>
            </td>
        </tr>
}
    </tbody>
</table>
